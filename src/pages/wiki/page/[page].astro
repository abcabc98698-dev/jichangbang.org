---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/elements/PageHeader.astro";
import BlogSection from "@/components/sections/BlogSection.astro";
import JsonLd from "@/components/seo/JsonLd.astro";
import { getCollection } from "astro:content";

export const POSTS_PER_PAGE = 12;

export async function getStaticPaths() {
  const allPosts = await getCollection("post");

  let posts = allPosts.sort(
    (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
  );

  const featuredPost = posts.find((post) => post.data.featured);
  if (featuredPost) {
    posts = posts.filter((post) => post.data.featured !== true);
  }

  const totalPages = Math.ceil(posts.length / POSTS_PER_PAGE);

  return Array.from({ length: totalPages }, (_, i) => {
    const page = i + 1;
    return {
      params: { page: page.toString() },
      props: { page: page.toString(), totalPages }
    };
  });
}

const { page } = Astro.props;
const currentPage = parseInt(page);

if (currentPage === 1) {
  return Astro.redirect("/wiki/", 301);
}

const breadcrumbs = [
  { name: "首页", url: "/" },
  { name: "知识百科", url: "/wiki" },
  { name: `第 ${currentPage} 页`, url: `/wiki/page/${currentPage}` }
];
---

<Layout
  title={`出海网络常青知识百科 — 第 ${currentPage} 页【2026百科】`}
  description={`机场榜一知识百科专栏第 ${currentPage} 页：发布专线原理深度科普、住宅家宽 IP 与机房 IP 辨析、晚高峰网络抖动成因以及出海网络抗封锁核心知识。`}
  keywords="机场百科, 出海网络知识库, IEPL专线原理, 住宅IP科普, 机场选购指南, 机场榜一"
>
  <JsonLd type="BreadcrumbList" breadcrumbs={breadcrumbs} />

  <section class="relative z-20 site-container my-10 md:my-16">
    <PageHeader
      title={currentPage > 1 ? `出海网络常青知识百科 (第 ${currentPage} 页)` : "出海网络常青知识百科"}
      description="去伪存真，系统拆解物理专线、海外 IP 归属、晚高峰 QoS 策略与客户端底层的常青知识库。"
    />
  </section>

  <section class="relative z-20 site-container mb-16">
    <BlogSection
      title=""
      collection="wiki"
      listPage={true}
      pagination={{
        enable: true,
        currentPage: currentPage
      }}
      postsPerPage={POSTS_PER_PAGE}
    />
  </section>
</Layout>
