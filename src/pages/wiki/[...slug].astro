---
import { getCollection, render } from "astro:content";
import PostLayout from "@/layouts/PostLayout.astro";
import Toc from '@/components/widgets/Toc.astro';
import JsonLd from "@/components/seo/JsonLd.astro";

export async function getStaticPaths() {
	const postEntries = await getCollection("post");
	return postEntries.map((entry) => {
		const slugString = entry.id;
		return {
			params: { slug: slugString },
			props: { entry },
		};
	});
}

const { entry } = Astro.props;

if (!entry) {
	return Astro.redirect("/404");
}

const { Content, headings } = await render(entry);
const filtered = headings.filter(h => h.depth <= 2);

const breadcrumbs = [
  { name: "首页", url: "/" },
  { name: "知识百科", url: "/wiki" },
  { name: entry.data.title, url: `/wiki/${entry.id}` }
];
---

<PostLayout title={entry.data.title} description={entry.data.description}>
	<JsonLd type="BreadcrumbList" breadcrumbs={breadcrumbs} />
	<JsonLd
		type="Article"
		article={{
			title: entry.data.title,
			description: entry.data.description,
			publishDate: entry.data.publishDate,
			url: `https://jichangbang.org/wiki/${entry.id}`
		}}
	/>
	<!-- Reading progress bar -->
	<div id="reading-progress" class="reading-progress" style="transform: scaleX(0);"></div>

	<div class="post article">
		<main class="relative site-container mx-auto my-8 md:my-12">
			<!-- Article header -->
			<header class="article-header">
				<!-- Tags -->
				<div class="article-tags">
					{entry.data.tags && entry.data.tags.length > 0 ? (
						entry.data.tags.map(tag => (
							<span class="article-tag letter-spacing-wide text-xs">{tag}</span>
						))
					) : (
						<span class="article-tag text-xs">知识库</span>
					)}
				</div>

				<!-- Title -->
				<h1 class="article-title font-brand">
					{entry.data.title}
				</h1>

				<!-- Subtitle / Description -->
				{entry.data.description && (
					<p class="article-description text-neutral-600 dark:text-neutral-400">
						{entry.data.description}
					</p>
				)}

				<!-- Article meta -->
				<div class="article-meta text-xs text-neutral-500">
					<span>发布日期：{entry.data.publishDate.toLocaleDateString('zh-CN')}</span>
					{entry.data.read && <span> · 阅读需 {entry.data.read} 分钟</span>}
				</div>
			</header>

			<!-- Article content layout -->
			<div class="grid grid-cols-1 lg:grid-cols-4 gap-8 mt-8">
				<!-- Main content -->
				<article class="lg:col-span-3 prose dark:prose-invert max-w-none">
					<Content />
				</article>

				<!-- Table of contents -->
				{filtered.length > 0 && (
					<aside class="hidden lg:block lg:col-span-1">
						<div class="sticky top-24 p-4 rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10">
							<h4 class="text-xs font-bold text-neutral-800 dark:text-neutral-200 mb-3 uppercase tracking-wider">目录导航</h4>
							<Toc headings={filtered} />
						</div>
					</aside>
				)}
			</div>
		</main>
	</div>
</PostLayout>
