---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/elements/PageHeader.astro";
import Badge from "@/components/ui/Badge.astro";
import JsonLd from "@/components/seo/JsonLd.astro";
import { airports } from "@/data/airports";
import {
  Calculator,
  TrendingUp,
  Coins,
  ShieldCheck,
  Zap,
  Sparkles,
  Award
} from "@lucide/astro";

const breadcrumbs = [
  { name: "首页", url: "/" },
  { name: "价格套餐", url: "/pricing" }
];

// 保持用户统一排位
const sortedAirports = [...airports];

// 8组高价值价格长尾FAQ
const faqItems = [
  {
    question: "新手选择机场应该买月付还是年付？",
    answer: "新手首次使用任何机场服务商，强烈建议优先选择一个月月付。不同用户的物理宽带环境存在差异，即使他人使用稳定，本地运营商晚高峰路由也可能受到波动影响。通过单月实测验证晚高峰测速、延迟与AI解锁情况满意后，若该服务商运营超过三年且口碑良好，再考虑季度或年度订阅锁定优惠，切忌在新开平台直接购买长期套餐。"
  },
  {
    question: "5元到10元的便宜机场和20元以上的专线机场差距在哪里？",
    answer: "核心差距主要体现在物理线路成本与带宽超卖比例。5元到10元档位通常采用公网直连或合租隧道，晚高峰20点到23点国际出口拥堵时丢包率显著上升，且多采用机房广播IP，易触发ChatGPT等平台的风控拦截。20元以上档位多采用IEPL或IPLC企业内网专线，物理光缆不经过公共防火墙审查，晚高峰零丢包，并配备原生住宅双ISP纯净IP，延迟与流媒体体验完全处于不同量级。"
  },
  {
    question: "什么是不限时按量付费套餐？适合哪些人群？",
    answer: "不限时按量付费套餐指用户一次性购买固定流量包，该流量包不设置月度重置日期与到期时间，直到流量实际消耗完毕为止。此类套餐非常适合出差备用、仅用于查阅学术文献、发送邮件或者作为主力专线突发故障时的第二备用通道，可以彻底避免每月固定月租到期清零造成的资金浪费。"
  },
  {
    question: "机场套餐标称的每GB单价应该如何科学核算？",
    answer: "科学计算公式为套餐月付金额除以当月可用流量，同时必须结合节点实际倍率进行修正。例如某套餐标价15元提供150GB流量，名义单价为0.10元每GB。但若该平台仅有3倍率或5倍率节点可用，实际等效可用流量缩水至30GB到50GB，真实每GB单价将骤增至0.30元到0.50元。因此必须优先选用标明全节点1.0倍率无暗扣的服务商。"
  },
  {
    question: "网上流传的9.9元包年1000GB机场靠谱吗？",
    answer: "此类套餐在经济学与商业逻辑上无法持续。当前跨境专线带宽与优质服务器出口成本高昂，每Mbps单月物理成本在数十元至上百元不等。9.9元包年纯属利用极低价格在短期内吸纳大量资金的击穿式资金盘，此类平台通常在运营两到三个月后服务器超载卡顿瘫痪，或者直接关闭网站跑路失联，用户切莫贪图便宜遭受本金损失。"
  },
  {
    question: "购买机场套餐后如果发现连不上或者速度慢能否申请退款？",
    answer: "由于虚拟网络服务的即时交付与流量消耗属性，绝大多数机场服务商在服务条款中明确声明不支持无理由退款，部分优质品牌仅在节点全线大面积故障超过24小时或未产生实际流量的前数小时内提供有限退款支持。这也是建议新用户务必通过月付或小额试用套餐先行验证可用性的核心原因。"
  },
  {
    question: "如何获取机场的最新打折优惠码与续费折扣？",
    answer: "主流机场通常在元旦、春节、年中大促与双十一期间发布全场8折至85折优惠码。本站与各大服务商建立了专属通道，例如光速云专属8折优惠码AMM，在结账结算页面输入优惠码即可直接立减。同时，选择年付周期通常享有两到三个月的月费减免，叠加大促优惠码后年化成本最为划算。"
  },
  {
    question: "套餐内的月流量用完了会怎样？中途可以单独叠加流量包吗？",
    answer: "套餐内月度流量耗尽后，系统会自动熔断节点连接权限，客户端将表现为节点超时或无法加载网页。大部分采用成熟面板的服务商均提供临时流量叠加包或提前重置账单周期的功能，用户可登录用户后台按需购买额外流量包，无需直接重新购买新套餐。"
  }
];
---

<Layout
  title="机场价格套餐大全与每GB成本精算 5元/10元/15元/20元/30元及不限时按量付费"
  description="2026 机场价格套餐完整决策指南：涵盖 5-10元平民特惠、15-20元高性价比真实月付专线、25-35元企业级全专线旗舰，以及不限时按量付费备用套餐。内置多维价格计算器与42家机场每GB单价对账大盘，拒绝套路多花冤枉钱。"
  keywords="机场价格, 便宜机场, 10元机场, 15元机场, 20元机场, 30元专线, 不限时机场, 按量付费机场, 机场套餐, 机场月付, 机场价格计算器, 机场每GB成本, 机场榜一"
>
  <JsonLd type="BreadcrumbList" breadcrumbs={breadcrumbs} />
  <JsonLd type="FAQPage" faqItems={faqItems} />

  <!-- 页面头部 -->
  <section class="relative z-20 site-container my-10 md:my-14">
    <PageHeader
      title="机场价格套餐大全与每GB成本精算"
      description="横向穿透 42 家主流机场定价机制。从 7 元平民入门到 23 元企业级全专线旗舰，提供按月付、按年付与不限时按量多维筛选，依托带宽物理成本模型助你科学精算每一分预算。"
    />

    <!-- 快速导航胶囊 -->
    <div class="flex flex-wrap gap-2 pt-6">
      <a href="#calculator" class="px-3.5 py-1.5 rounded-full bg-primary/10 text-primary text-xs font-semibold hover:bg-primary/20 transition-colors">
        🧮 智能价格计算器
      </a>
      <a href="#master-matrix" class="px-3.5 py-1.5 rounded-full bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/15 text-xs text-neutral-600 dark:text-neutral-300 hover:border-primary/40 transition-colors">
        📊 42家价格对账大盘
      </a>
      <a href="#tiers" class="px-3.5 py-1.5 rounded-full bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/15 text-xs text-neutral-600 dark:text-neutral-300 hover:border-primary/40 transition-colors">
        🏷️ 五大价格阶梯横评
      </a>
      <a href="#cost-economics" class="px-3.5 py-1.5 rounded-full bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/15 text-xs text-neutral-600 dark:text-neutral-300 hover:border-primary/40 transition-colors">
        💡 每GB物理成本模型
      </a>
      <a href="#pitfalls" class="px-3.5 py-1.5 rounded-full bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/15 text-xs text-neutral-600 dark:text-neutral-300 hover:border-primary/40 transition-colors">
        ⚠️ 月付年付防套路指南
      </a>
      <a href="#faq" class="px-3.5 py-1.5 rounded-full bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/15 text-xs text-neutral-600 dark:text-neutral-300 hover:border-primary/40 transition-colors">
        ❓ 价格高频答疑
      </a>
    </div>
  </section>

  <!-- 🧮 模块一：交互式多维价格与套餐智能计算器 -->
  <section class="py-6 site-container" id="calculator">
    <div class="p-6 md:p-10 rounded-2xl bg-gradient-to-br from-bg-secondary via-bg-secondary to-primary/5 dark:from-bg-secondary-dark dark:to-neutral-900 border border-primary/20 shadow-sm">
      <div class="flex items-center gap-3 mb-4">
        <span class="p-2.5 rounded-xl bg-primary text-white shadow-sm">
          <Calculator class="w-6 h-6" />
        </span>
        <div>
          <h2 class="text-xl md:text-2xl font-bold font-brand text-neutral-900 dark:text-neutral-100">
            机场价格与套餐多维智能计算器
          </h2>
          <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5">
            输入你的真实月度预算、流量消耗与核心应用场景，系统即刻推算最契合的服务商与订阅套餐
          </p>
        </div>
      </div>

      <!-- 四维联动选择表单 -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 my-6">
        <!-- 维度 1：月度预算 -->
        <div class="p-4 rounded-xl bg-bg-primary dark:bg-neutral-800/80 border border-primary/10">
          <label class="block text-xs font-bold text-neutral-700 dark:text-neutral-200 mb-2">
            1. 每月开销预算
          </label>
          <select id="calc-budget" class="w-full p-2.5 rounded-lg bg-bg-secondary dark:bg-neutral-900 border border-primary/20 text-xs text-neutral-800 dark:text-neutral-200 focus:outline-none focus:border-primary">
            <option value="low">≤ 10 元 / 月（轻度学生党）</option>
            <option value="mid">15 - 20 元 / 月（主流高性价比）</option>
            <option value="high" selected>23 - 35 元 / 月（高端专线旗舰）</option>
            <option value="metered">按量付费（不限时间长期备用）</option>
          </select>
        </div>

        <!-- 维度 2：月流量预估 -->
        <div class="p-4 rounded-xl bg-bg-primary dark:bg-neutral-800/80 border border-primary/10">
          <label class="block text-xs font-bold text-neutral-700 dark:text-neutral-200 mb-2">
            2. 每月流量预估
          </label>
          <select id="calc-traffic" class="w-full p-2.5 rounded-lg bg-bg-secondary dark:bg-neutral-900 border border-primary/20 text-xs text-neutral-800 dark:text-neutral-200 focus:outline-none focus:border-primary">
            <option value="50">30 - 60 GB（查资料/社交文字）</option>
            <option value="150" selected>100 - 180 GB（日常影音/AI辅助）</option>
            <option value="300">250 GB 以上（全天4K/重度下载）</option>
          </select>
        </div>

        <!-- 维度 3：核心使用场景 -->
        <div class="p-4 rounded-xl bg-bg-primary dark:bg-neutral-800/80 border border-primary/10">
          <label class="block text-xs font-bold text-neutral-700 dark:text-neutral-200 mb-2">
            3. 核心主力场景
          </label>
          <select id="calc-scene" class="w-full p-2.5 rounded-lg bg-bg-secondary dark:bg-neutral-900 border border-primary/20 text-xs text-neutral-800 dark:text-neutral-200 focus:outline-none focus:border-primary">
            <option value="ai" selected>ChatGPT / Claude / Cursor 编程</option>
            <option value="video">Netflix / YouTube 4K 极速追剧</option>
            <option value="game">Steam / 外服游戏低延迟电竞</option>
            <option value="backup">长线应急防失联备用</option>
          </select>
        </div>

        <!-- 维度 4：支付偏好 -->
        <div class="p-4 rounded-xl bg-bg-primary dark:bg-neutral-800/80 border border-primary/10">
          <label class="block text-xs font-bold text-neutral-700 dark:text-neutral-200 mb-2">
            4. 订阅支付偏好
          </label>
          <select id="calc-period" class="w-full p-2.5 rounded-lg bg-bg-secondary dark:bg-neutral-900 border border-primary/20 text-xs text-neutral-800 dark:text-neutral-200 focus:outline-none focus:border-primary">
            <option value="monthly" selected>纯月付无捆绑（安全自由）</option>
            <option value="annual">年付折扣优先（摊薄单月成本）</option>
            <option value="paygo">按量永不过期（随充随用）</option>
          </select>
        </div>
      </div>

      <!-- 计算结果动态卡片 -->
      <div id="calc-result" class="p-6 rounded-2xl bg-bg-primary dark:bg-neutral-800 border-2 border-primary/30 shadow-md">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div class="space-y-1.5">
            <div class="flex items-center gap-2">
              <span class="px-2.5 py-0.5 rounded-full bg-primary text-white text-[11px] font-bold">
                智能算法推荐方案
              </span>
              <span id="result-badge" class="px-2 py-0.5 rounded text-[11px] font-semibold bg-amber-500/10 text-amber-600 dark:text-amber-400">
                综合评分 9.9 旗舰榜首
              </span>
            </div>
            <h3 id="result-title" class="text-xl font-extrabold text-neutral-900 dark:text-neutral-100">
              光速云 全球 IPLC 专线旗舰
            </h3>
            <p id="result-desc" class="text-xs text-neutral-600 dark:text-neutral-300 max-w-3xl leading-relaxed">
              推荐极速版 23元/月（148GB 全球 IPLC 2.5Gbps 专线，晚高峰零丢包实测 980 Mbps，原生住宅双 ISP IP 全解锁 ChatGPT 4o 与 Netflix）。专属 8 折优惠码 AMM，折后仅需 18.4 元/月。
            </p>
            <div id="result-specs" class="flex flex-wrap items-center gap-4 text-xs text-neutral-500 dark:text-neutral-400 pt-1">
              <span>测算单价：<strong class="text-primary">¥0.12 / GB</strong></span>
              <span>线路拓扑：<strong class="text-neutral-800 dark:text-neutral-200">IEPL/IPLC 企业专线</strong></span>
              <span>节点倍率：<strong class="text-emerald-600 dark:text-emerald-400">全线 1.0x 无套路</strong></span>
              <span>专属优惠码：<code class="px-1.5 py-0.5 rounded bg-primary/10 text-primary font-mono font-bold">AMM</code></span>
            </div>
          </div>

          <div class="flex sm:flex-col items-center gap-2 flex-shrink-0">
            <a
              id="result-link"
              href="/reviews/guangsu"
              class="w-full sm:w-auto px-6 py-3 rounded-xl bg-primary text-white text-xs font-bold text-center hover:opacity-90 shadow-sm transition-all"
            >
              查看评测与套餐直达
            </a>
            <a
              id="result-aff"
              href="https://gsy001.xyz"
              target="_blank"
              rel="noopener noreferrer nofollow sponsored"
              class="w-full sm:w-auto px-6 py-2.5 rounded-xl bg-bg-secondary dark:bg-neutral-700 text-neutral-700 dark:text-neutral-200 text-xs font-semibold text-center hover:border-primary border border-transparent transition-all"
            >
              访问官网订购
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 📊 模块二：全站 42 家机场价格与每 GB 单价全景对账大盘 -->
  <section class="py-10 site-container" id="master-matrix">
    <div class="mb-6">
      <div class="mb-2 inline-block">
        <Badge variant="accent">价格对账大盘</Badge>
      </div>
      <h2 class="text-2xl font-bold font-brand text-neutral-900 dark:text-neutral-100">
        全站 42 家机场价格、套餐门槛与每 GB 成本横向矩阵
      </h2>
      <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1">
        数据均采自各服务商真实在售套餐，折合单月成本已按最短订阅周期核算，拒绝隐性高倍率虚假宣传
      </p>
    </div>

    <!-- 响应式表格外容器 -->
    <div class="overflow-x-auto rounded-2xl border border-primary/20 shadow-sm bg-bg-primary dark:bg-bg-secondary-dark">
      <table class="w-full text-left text-xs border-collapse min-w-[850px]">
        <thead>
          <tr class="bg-neutral-50 dark:bg-neutral-800/80 border-b border-primary/10 text-neutral-600 dark:text-neutral-300">
            <th class="p-3.5 font-bold">排位与品牌</th>
            <th class="p-3.5 font-bold">最低起步价</th>
            <th class="p-3.5 font-bold">起付门槛</th>
            <th class="p-3.5 font-bold">主力推荐套餐</th>
            <th class="p-3.5 font-bold">流量容量</th>
            <th class="p-3.5 font-bold">测算每GB单价</th>
            <th class="p-3.5 font-bold">线路架构</th>
            <th class="p-3.5 font-bold">专属优惠码</th>
            <th class="p-3.5 font-bold text-center">评测与通道</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-primary/5 text-neutral-700 dark:text-neutral-200">
          {sortedAirports.map((airport, index) => {
            const unitPrice = (airport.monthlyPrice / (airport.traffic || 100)).toFixed(2);
            const isTopRank = index === 0;
            return (
              <tr class={isTopRank ? "bg-primary/5 dark:bg-primary/10 font-semibold" : "hover:bg-neutral-50/50 dark:hover:bg-neutral-800/30"}>
                <td class="p-3.5 flex items-center gap-2">
                  <span class={`w-5 h-5 rounded-full flex items-center justify-center text-[10px] font-bold ${
                    index === 0 ? "bg-amber-500 text-white" :
                    index === 1 ? "bg-slate-400 text-white" :
                    index === 2 ? "bg-amber-700 text-white" : "bg-neutral-200 dark:bg-neutral-700 text-neutral-600 dark:text-neutral-300"
                  }`}>
                    {index + 1}
                  </span>
                  <div>
                    <a href={`/reviews/${airport.slug}`} class="text-neutral-900 dark:text-neutral-100 hover:text-primary hover:underline font-bold">
                      {airport.name}
                    </a>
                    {isTopRank && (
                      <span class="ml-1.5 px-1.5 py-0.2 rounded bg-primary text-white text-[9px]">主推金牌</span>
                    )}
                  </div>
                </td>
                <td class="p-3.5">
                  <span class="text-sm font-bold text-primary">¥{airport.monthlyPrice}</span>
                  <span class="text-[10px] text-neutral-400">/月起</span>
                </td>
                <td class="p-3.5">
                  <span class={`px-2 py-0.5 rounded text-[10px] ${
                    airport.minDuration === '月付' ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-semibold" :
                    airport.minDuration === '不限时按量' ? "bg-blue-500/10 text-blue-600 dark:text-blue-400 font-semibold" :
                    "bg-neutral-200 dark:bg-neutral-700 text-neutral-600 dark:text-neutral-300"
                  }`}>
                    {airport.minDuration}
                  </span>
                </td>
                <td class="p-3.5 text-neutral-800 dark:text-neutral-200">
                  {airport.packages && airport.packages.length > 0 ? airport.packages[0].name : "基础均衡版"}
                </td>
                <td class="p-3.5 font-medium">
                  {airport.traffic} GB
                </td>
                <td class="p-3.5">
                  <span class="font-mono text-neutral-900 dark:text-neutral-100 font-semibold">
                    ¥{unitPrice}
                  </span>
                  <span class="text-[10px] text-neutral-400">/GB</span>
                </td>
                <td class="p-3.5">
                  <span class="text-[11px]">{airport.lineType}</span>
                </td>
                <td class="p-3.5">
                  {airport.couponCode ? (
                    <code class="px-1.5 py-0.5 rounded bg-primary/10 text-primary font-mono text-[11px] font-bold">
                      {airport.couponCode}
                    </code>
                  ) : (
                    <span class="text-neutral-400 text-[10px]">直购特惠</span>
                  )}
                </td>
                <td class="p-3.5 text-center">
                  <div class="flex items-center justify-center gap-1.5">
                    <a
                      href={`/reviews/${airport.slug}`}
                      class="px-2.5 py-1 rounded bg-bg-secondary dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 hover:text-primary hover:border-primary border border-primary/10 text-[11px]"
                    >
                      评测
                    </a>
                    <a
                      href={airport.affiliateUrl}
                      target="_blank"
                      rel="noopener noreferrer nofollow sponsored"
                      class="px-2.5 py-1 rounded bg-primary text-white hover:opacity-90 text-[11px] font-semibold"
                    >
                      直达
                    </a>
                  </div>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>

  <!-- 🏷️ 模块三：五大价格阶梯深度横评 -->
  <section class="py-10 site-container" id="tiers">
    <div class="mb-8">
      <div class="mb-2 inline-block">
        <Badge variant="primary">阶梯精选</Badge>
      </div>
      <h2 class="text-2xl font-bold font-brand text-neutral-900 dark:text-neutral-100">
