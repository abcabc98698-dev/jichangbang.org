                <td class="p-3.5">
                  <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-bold text-[11px] inline-flex items-center gap-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                    {airport.riskStatus}
                  </span>
                </td>
                <td class="p-3.5 text-neutral-700 dark:text-neutral-300">
                  {airport.lineType}
                </td>
                <td class="p-3.5">
                  <span class={`px-2 py-0.5 rounded text-[10px] ${
                    airport.minDuration === '月付' ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-semibold" :
                    airport.minDuration === '不限时按量' ? "bg-purple-500/10 text-purple-600 dark:text-purple-400 font-semibold" :
                    "bg-neutral-200 dark:bg-neutral-700 text-neutral-600 dark:text-neutral-300"
                  }`}>
                    {airport.minDuration}
                  </span>
                </td>
                <td class="p-3.5 text-neutral-600 dark:text-neutral-300 leading-relaxed max-w-xs text-[11px]">
                  {airport.riskNote}
                </td>
                <td class="p-3.5 text-center">
