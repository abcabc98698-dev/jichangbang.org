                    href={`/reviews/${airport.slug}`}
                    class="px-2.5 py-1 rounded bg-bg-secondary dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 hover:text-primary hover:border-primary border border-primary/10 text-[11px]"
                  >
                    评测
                  </a>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
