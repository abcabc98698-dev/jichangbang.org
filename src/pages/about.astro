---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/elements/PageHeader.astro";
import Button from "@/components/ui/Button.astro";
import Badge from "@/components/ui/Badge.astro";
import JsonLd from "@/components/seo/JsonLd.astro";
import { ArrowRight, ShieldCheck, Heart, Users, CheckCircle2 } from "@lucide/astro";

const breadcrumbs = [
  { name: "首页", url: "/" },
  { name: "关于我们", url: "/about" }
];
---

<Layout
  title="关于机场榜一 — 客观·专业·真实的2026机场评测与排行榜平台"
  description="了解机场榜一 (jichangbang.org)：我们的初衷、独立第三方评测原则、测速方法学与风险监督体系。致力于为出海从业者提供透明靠谱的决策指南。"
  keywords="关于机场榜一, 机场评测原则, 测速方法学, 机场榜一"
>
  <JsonLd type="BreadcrumbList" breadcrumbs={breadcrumbs} />

  <section class="site-container my-12">
    <PageHeader
      title="关于机场榜一 (jichangbang.org)"
      description="专注于客观实测的 2026 机场推荐与排行榜单总入口。拒绝虚假宣传，致力于为出海从业者、开发者与影音爱好者提供可靠的决策依据。"
    />
  </section>

  <section class="site-container max-w-3xl mx-auto pb-24">
    <article class="space-y-10 text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed">
      <!-- 创立初衷 -->
      <div class="p-6 md:p-8 rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10">
        <h2 class="text-xl font-bold font-brand text-neutral-800 dark:text-neutral-100 mb-4">
          一、我们的创立初衷
        </h2>
        <div class="space-y-4">
          <p>
            在出海网络代理行业中，充斥着大量虚假宣传、跑路收割以及利益挂钩的“水军推荐”。许多新手因为贪图低价购买了劣质直连，一到晚高峰便频繁断流丢包；更有人轻信所谓“永久套餐”，结果几天后服务商卷款跑路。
          </p>
          <p>
            <strong>机场榜一</strong> 的诞生就是为了打破这种信息不对称。我们自建了跨地区节点监控集群，常态化对收录品牌进行晚高峰测速、丢包率采样、AI 与流媒体解锁校验，并建立公开透明的风险雷达与预警机制。
          </p>
        </div>
      </div>

      <!-- 核心评测准则 -->
      <div class="p-6 md:p-8 rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10">
        <h2 class="text-xl font-bold font-brand text-neutral-800 dark:text-neutral-100 mb-4">
          二、独立第三方的评测原则
        </h2>
        <ul class="space-y-3">
          <li class="flex items-start gap-2">
            <CheckCircle2 class="w-4 h-4 text-primary flex-shrink-0 mt-0.5" />
            <span><strong>晚高峰实测优先：</strong> 白天网络通畅不代表好用，所有测速数据严格以 20:00 - 23:00 晚高峰多地实测为基准。</span>
          </li>
          <li class="flex items-start gap-2">
            <CheckCircle2 class="w-4 h-4 text-primary flex-shrink-0 mt-0.5" />
            <span><strong>拒绝虚标与包装：</strong> 严格核查商家底层线路是纯 IEPL 专线、BGP 隧道还是普通直连，杜绝概念包装。</span>
          </li>
          <li class="flex items-start gap-2">
            <CheckCircle2 class="w-4 h-4 text-primary flex-shrink-0 mt-0.5" />
            <span><strong>优先推荐月付：</strong> 无论任何品牌，一律引导用户优先按月订阅，从源头上杜绝跑路风险。</span>
          </li>
          <li class="flex items-start gap-2">
            <CheckCircle2 class="w-4 h-4 text-primary flex-shrink-0 mt-0.5" />
            <span><strong>异常实时预警：</strong> 发现域名失效、TG 群组异常关闭或连续断流超过 48 小时，第一时间同步至风险情报雷达。</span>
          </li>
        </ul>
      </div>

      <div class="text-center pt-6">
        <Button url="/recommend" type="fill" className="text-sm px-8 py-3">
          前往 2026 机场推荐主榜 <ArrowRight size={16} />
        </Button>
      </div>
    </article>
  </section>
</Layout>
