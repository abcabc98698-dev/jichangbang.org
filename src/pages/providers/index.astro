<script>
  // 交互式多维筛选与模糊搜索脚本
  document.addEventListener("DOMContentLoaded", () => {
    const searchInput = document.getElementById("search-input") as HTMLInputElement | null;
    const lineFilter = document.getElementById("line-filter") as HTMLSelectElement | null;
    const priceFilter = document.getElementById("price-filter") as HTMLSelectElement | null;
    const featureFilter = document.getElementById("feature-filter") as HTMLSelectElement | null;
    const resetBtn = document.getElementById("reset-filter-btn") as HTMLButtonElement | null;
    const filteredCountEl = document.getElementById("filtered-count");
    const noResultsBox = document.getElementById("no-results-box");
    const rows = document.querySelectorAll<HTMLTableRowElement>(".airport-row");

    function applyFilter() {
      const keyword = (searchInput?.value || "").trim().toLowerCase();
      const lineVal = lineFilter?.value || "all";
      const priceVal = priceFilter?.value || "all";
      const featureVal = featureFilter?.value || "all";

      let visibleCount = 0;

      rows.forEach((row) => {
        const name = row.dataset.name || "";
        const line = row.dataset.line || "";
        const price = parseFloat(row.dataset.price || "0");
        const duration = row.dataset.duration || "";
        const protocols = row.dataset.protocols || "";
        const isResidential = row.dataset.residential === "true";
        const hasCustomClient = row.dataset.customClient === "true";
        const is4K = row.dataset["4k"] === "true";

        // 关键词过滤
        let matchesKeyword = true;
        if (keyword) {
          matchesKeyword = name.includes(keyword) || protocols.includes(keyword) || line.toLowerCase().includes(keyword);
        }

        // 线路拓扑过滤
        let matchesLine = true;
        if (lineVal === "专线") {
          matchesLine = line.includes("专线");
        } else if (lineVal === "BGP") {
          matchesLine = line.includes("BGP");
        } else if (lineVal === "直连") {
          matchesLine = line.includes("直连") || line.includes("混合");
        }

        // 价格预算过滤
        let matchesPrice = true;
        if (priceVal === "budget") {
          matchesPrice = price <= 10;
        } else if (priceVal === "mid") {
          matchesPrice = price > 10 && price <= 20;
        } else if (priceVal === "pro") {
          matchesPrice = price > 20;
        } else if (priceVal === "payasyougo") {
          matchesPrice = duration.includes("按量");
        }

        // 增值特性过滤
        let matchesFeature = true;
        if (featureVal === "residential") {
          matchesFeature = isResidential;
        } else if (featureVal === "custom-client") {
          matchesFeature = hasCustomClient;
        } else if (featureVal === "4k") {
          matchesFeature = is4K;
        }

        if (matchesKeyword && matchesLine && matchesPrice && matchesFeature) {
          row.style.display = "";
          visibleCount++;
        } else {
          row.style.display = "none";
        }
      });

      if (filteredCountEl) {
        filteredCountEl.textContent = String(visibleCount);
      }

      if (noResultsBox) {
        if (visibleCount === 0) {
          noResultsBox.classList.remove("hidden");
        } else {
          noResultsBox.classList.add("hidden");
        }
      }
    }

    searchInput?.addEventListener("input", applyFilter);
    lineFilter?.addEventListener("change", applyFilter);
    priceFilter?.addEventListener("change", applyFilter);
    featureFilter?.addEventListener("change", applyFilter);

    resetBtn?.addEventListener("click", () => {
      if (searchInput) searchInput.value = "";
      if (lineFilter) lineFilter.value = "all";
      if (priceFilter) priceFilter.value = "all";
      if (featureFilter) featureFilter.value = "all";
      applyFilter();
    });

    // 优惠码点击一键复制
    const copyBtns = document.querySelectorAll<HTMLElement>(".coupon-copy-btn");
    copyBtns.forEach((btn) => {
      btn.addEventListener("click", async () => {
        const code = btn.dataset.code;
        if (!code) return;
        try {
          await navigator.clipboard.writeText(code);
          const originalText = btn.innerHTML;
          btn.innerHTML = `已复制！`;
          setTimeout(() => {
            btn.innerHTML = originalText;
          }, 1500);
        } catch {
          // fallback
        }
      });
    });
  });
</script>
