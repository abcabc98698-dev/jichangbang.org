---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/elements/PageHeader.astro";
import JsonLd from "@/components/seo/JsonLd.astro";
import { airports } from "@/data/airports";
import { directoryAirports } from "@/data/directory-airports";
import {
  Database,
  Search,
  Zap,
  Wrench,
  ExternalLink,
  Server,
  Check,
  Activity,
  Globe,
  Copy,
  ArrowRight,
  Sparkles
} from "@lucide/astro";

const breadcrumbs = [
  { name: "首页", url: "/" },
  { name: "服务商数据库", url: "/providers" }
];

// 保持全站统一 18 家排位
const sortedAirports = [...airports];

// ItemList 结构化数据映射
const itemListData = sortedAirports.map((airport, index) => ({
  name: airport.name,
  url: `https://jichangbang.org/reviews/${airport.slug}`,
  position: index + 1
}));

// 8组高价值数据库与参数检索长尾问答
const faqItems = [
  {
    question: "本数据库收录的 18 家机场底层参数多长时间核验更新一次？",
    answer: "数据库参数保持动态监测与周期核验机制。连通性、晚高峰平均测速与丢包率采用自动化探针每日 20 点至 23 点进行流式采集；节点数量、套餐价格与当期优惠码每周与各服务商后台同步对账；而原生住宅双 ISP 属性检测（涵盖 ASN 机构属性与 Scamalytics 欺诈分值）每月进行全量回扫重测，确保全站呈现的数据真实客观、具备可复现性。"
  },
  {
    question: "为什么有些服务商标称几百个节点，实际使用体验却不如几十个专线节点的机场？",
    answer: "节点数量与网络可用性之间不存在正向线性关系。部分低质机场为了营销宣传，使用公网单台小带宽 VPS 服务器通过端口映射虚构出几十个重复节点，或者采用高超卖率的廉价广播云机房，一旦遇到晚高峰网络拥塞或敏感期审查，大面积节点瞬间变红超时。真正的高品质服务商（如光速云）聚焦于点对点大带宽 IPLC 或 IEPL 物理专线，即便单地区仅部署数条经过优化的主力线路，单节点物理吞吐量即可达 2.5Gbps，稳定性与响应速度远超虚标节点数千条的劣质平台。"
  },
  {
    question: "什么是节点的倍率？为什么在数据库参数中需要特别关注倍率标注？",
    answer: "节点倍率是机场服务端用于扣除账户流量额度的乘数系数。如果用户连接了 1.0x 倍率的节点，下载 1GB 文件将从账户扣除 1GB 流量；若连接 0.2x 倍率的低配节点，下载 1GB 仅扣除 200MB；然而部分不良服务商暗中部署 3.0x 甚至 5.0x 的高倍率节点，在用户不知情的情况下下载 1GB 视频瞬间扣除 3GB 至 5GB 流量，导致每月额度几天内被快速耗尽。数据库建议优先选择全节点恒定 1.0x 倍率或清晰公示倍率的透明服务商。"
  },
  {
    question: "原生住宅双 ISP 属性在数据库中是如何进行客观检测与认证的？",
    answer: "认证流程遵循业界公认的复合检测标准。首先提取服务商节点的真实公网出网 IP，通过 BGP 路由广播数据库检索其自治系统号（ASN），确认所属运营商为海外本土居民家庭宽带提供商（如 AT&T、Comcast、NTT 或 HKBN）；其次调用 ipinfo.io 查询其类型标签，要求必须明确标注为 isp 属性且严格排除 hosting 数据中心机房；最后结合 Scamalytics 商业风控数据库扫描，其欺诈风险分必须处于安全纯净区间，唯有同时满足上述三项指标才会在数据库中点亮该特性标签。"
  },
  {
    question: "为什么专线机场的最低起步价格普遍高于普通的公网中转或直连机场？",
    answer: "底层物理资源的采购成本存在天然的量级差距。普通公网直连或普通中转使用的是公网公共互联网路由，服务商仅需租用普通云主机按月付费；而正规企业级 IEPL 或 IPLC 专线属于跨国点对点物理隔离专线，需要向上游国际电信运营商按单 Gbps 物理带宽按月支付高昂的硬性租金，同时还要配备境内多线 BGP 高防汇聚入口与海外原生住宅 IP 资源池。高成本换来的是高峰期不过审查防火墙、丢包率接近零以及 20ms 级恒定超低物理延迟。"
  },
  {
    question: "数据库中的晚高峰实测速率是在什么网络环境和时间段下测得的？",
    answer: "所有测速数据均在网络流量最拥堵的晚间黄金时段（北京时间 20:00 至 23:00）实测采集。测试客户端统一采用无第三方干扰的原生内核客户端，分别接入国内三大主流宽带运营商（中国电信、中国联通、中国移动）千兆光纤网络，针对香港、日本、美国核心节点进行多线程流式下载拉取与 4K 超高清码率实时回放，测得的 Mbps 数值代表极端拥堵工况下的下限保障水平，而非凌晨空载时的理论峰值。"
  },
  {
    question: "购买了具备原生住宅双 ISP 的机场，为什么访问海外部分金融网站依然偶尔需要验证码？",
    answer: "这是客户端的会话保持策略与浏览器环境所致。虽然原生住宅 IP 具备极高的信誉评分，但若在客户端策略组中开启了自动优选（URL-Test 或 Load-Balance），客户端每隔几分钟在不同节点之间切换，导致访问金融网站时出网 IP 在不同国家或地区间频繁漂移，必然触发银行云端风控拦截。此外若浏览器保留了此前高风险机房 IP 产生的旧 Cookie 缓存，也会被风控系统读取。正确做法是手动锁定单一原生住宅节点，并在浏览器无痕隐身窗口中登录操作。"
  },
  {
    question: "如果数据库中的某家服务商优惠码提示失效或过期应该如何处理？",
    answer: "服务商优惠码分为通用长期折扣码与限时节假日特惠码。如光速云金牌专属优惠码 AMM（全单享受 8 折专属优惠）为长期有效代码；若在结算界面输入其他商家的特惠码提示失效，说明该批次优惠配额已提前领完。用户可点击该服务商的评测详情页查看最新更新的滚动备用码，或者直接选购其基础月付套餐，优先保障业务平稳运行。"
  }
];
---

<Layout
  title="机场服务商底层参数数据库 18+主流机场节点·协议·物理专线·住宅IP全网大盘【2026权威版】"
  description="2026机场服务商底层物理参数权威数据库。收录全网18家主流跨境机场真实网络规格：骨干线路（IEPL内网专线/IPLC/BGP中转）、出口协议（Shadowsocks/Trojan/Vless/Hysteria 2）、原生住宅双ISP纯净度、月基准流量与最低价格标准。支持多维动态筛选与快速模糊检索。"
  keywords="机场数据库, 机场参数查询, 机场服务商大全, 机场节点数, 专线机场清单, 原生住宅IP机场, 机场协议大全, 机场榜一"
>
  <JsonLd type="BreadcrumbList" breadcrumbs={breadcrumbs} />
  <JsonLd type="ItemList" itemList={itemListData} />
  <JsonLd type="FAQPage" faqItems={faqItems} />

  <!-- 头部英雄区 -->
  <section class="relative z-20 site-container my-10 md:my-14">
    <PageHeader
      title="机场服务商底层参数数据库：全网 18 家主流品牌技术规格大盘"
      description="拒绝浮夸宣传，以真实网络拓扑、实测物理吞吐、出网IP风控纯净度与协议支持为基准。结构化收录全网主流专线与中转服务商底层硬核参数，支持多维条件实时筛选与快速精准检索。"
    />

    <!-- 数据库核心大盘指标概览 -->
    <div class="mt-8 grid grid-cols-2 md:grid-cols-4 gap-3 text-xs">
      <div class="p-4 rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 flex items-center gap-3">
        <div class="w-8 h-8 rounded-lg bg-primary/10 text-primary flex items-center justify-center shrink-0">
          <Database class="w-4 h-4" />
        </div>
        <div>
          <div class="font-bold text-neutral-800 dark:text-neutral-200">167+ 家品牌数据库</div>
          <div class="text-neutral-500 text-[11px]">18 家核心 + 149 家收录</div>
        </div>
      </div>

      <div class="p-4 rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 flex items-center gap-3">
        <div class="w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-500 flex items-center justify-center shrink-0">
          <Server class="w-4 h-4" />
        </div>
        <div>
          <div class="font-bold text-neutral-800 dark:text-neutral-200">IPLC / IEPL 内网专线</div>
          <div class="text-neutral-500 text-[11px]">不过防火墙 0% 丢包率</div>
        </div>
      </div>

      <div class="p-4 rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 flex items-center gap-3">
        <div class="w-8 h-8 rounded-lg bg-blue-500/10 text-blue-500 flex items-center justify-center shrink-0">
          <Globe class="w-4 h-4" />
        </div>
        <div>
          <div class="font-bold text-neutral-800 dark:text-neutral-200">原生住宅双 ISP 认证</div>
          <div class="text-neutral-500 text-[11px]">零风控免验证运行 AI</div>
        </div>
      </div>

      <div class="p-4 rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 flex items-center gap-3">
        <div class="w-8 h-8 rounded-lg bg-amber-500/10 text-amber-500 flex items-center justify-center shrink-0">
          <Activity class="w-4 h-4" />
        </div>
        <div>
          <div class="font-bold text-neutral-800 dark:text-neutral-200">20:00-23:00 晚高峰</div>
          <div class="text-neutral-500 text-[11px]">真实下限测速数据背书</div>
        </div>
      </div>
    </div>
  </section>

  <!-- 多维交互式筛选引擎 -->
  <section class="py-4 site-container">
    <div class="p-6 md:p-8 rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/20 shadow-sm">
      <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" /></svg>
          <h2 class="text-lg font-bold font-brand text-neutral-900 dark:text-neutral-100">
            多维参数交互筛选引擎
          </h2>
        </div>
        <div class="flex items-center gap-3 text-xs">
          <span class="text-neutral-500">
            当前展示：<span id="filtered-count" class="text-primary font-bold text-sm">18</span> / 18 家品牌
          </span>
          <button
            id="reset-filter-btn"
            type="button"
            class="px-3 py-1.5 rounded-lg bg-bg-primary dark:bg-neutral-800 border border-primary/20 text-neutral-600 dark:text-neutral-300 hover:border-primary hover:text-primary transition text-xs font-medium"
          >
            重置所有条件
          </button>
        </div>
      </div>

      <!-- 搜索输入框与核心筛选控件 -->
      <div class="space-y-4 text-xs">
        <!-- 关键词搜索 -->
        <div class="relative">
          <Search class="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-neutral-400" />
          <input
            id="search-input"
            type="text"
            placeholder="搜索机场名称、协议（如 Shadowsocks / Hysteria2）、骨干线路或特性标签..."
            class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-bg-primary dark:bg-neutral-800 border border-primary/15 text-neutral-900 dark:text-neutral-100 placeholder-neutral-400 focus:outline-none focus:border-primary transition"
          />
        </div>

        <!-- 筛选维度网格 -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
          <!-- 线路拓扑筛选 -->
          <div>
            <label class="block text-neutral-500 mb-1.5 font-medium">骨干网络拓扑</label>
            <select
              id="line-filter"
              class="w-full px-3 py-2 rounded-xl bg-bg-primary dark:bg-neutral-800 border border-primary/15 text-neutral-800 dark:text-neutral-200 focus:outline-none focus:border-primary transition"
            >
              <option value="all">全部骨干拓扑（18家）</option>
              <option value="专线">仅看物理专线（IPLC / IEPL 内网）</option>
              <option value="BGP">仅看 BGP 隧道中转</option>
              <option value="直连">仅看 直连与多线混合</option>
            </select>
          </div>

          <!-- 价格预算区间 -->
          <div>
            <label class="block text-neutral-500 mb-1.5 font-medium">起步门槛与计费方式</label>
            <select
              id="price-filter"
              class="w-full px-3 py-2 rounded-xl bg-bg-primary dark:bg-neutral-800 border border-primary/15 text-neutral-800 dark:text-neutral-200 focus:outline-none focus:border-primary transition"
            >
              <option value="all">全部价格预算</option>
              <option value="budget">10元以下入门优选（单月 ≤ ¥10）</option>
              <option value="mid">15元至20元高性价比档</option>
              <option value="pro">20元以上高端生产力专线</option>
              <option value="payasyougo">不限时按量计费（长期备用）</option>
            </select>
          </div>

          <!-- 核心特性标签 -->
          <div>
            <label class="block text-neutral-500 mb-1.5 font-medium">核心增值技术特性</label>
            <select
              id="feature-filter"
              class="w-full px-3 py-2 rounded-xl bg-bg-primary dark:bg-neutral-800 border border-primary/15 text-neutral-800 dark:text-neutral-200 focus:outline-none focus:border-primary transition"
            >
              <option value="all">全部技术特性</option>
              <option value="residential">具备原生住宅双 ISP IP（防风控）</option>
              <option value="custom-client">配备独家自研免配置客户端</option>
              <option value="4k">晚高峰 800Mbps+ 4K秒开保障</option>
            </select>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 数据库超级大盘主表 -->
  <section class="py-6 site-container">
    <div class="p-6 md:p-8 rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/15 overflow-hidden">
      <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
        <div class="flex items-center gap-2">
          <Database class="w-5 h-5 text-primary" />
          <h2 class="text-xl font-bold font-brand text-neutral-900 dark:text-neutral-100">
            全网 18 家机场服务商底层网络参数大盘矩阵
          </h2>
        </div>
        <div class="text-xs text-neutral-500 bg-bg-primary dark:bg-neutral-800 px-3 py-1 rounded-lg border border-primary/10">
          数据基准：2026年9月晚高峰全天候实测
        </div>
      </div>

      <div class="overflow-x-auto">
        <table id="airports-table" class="w-full text-left border-collapse text-xs min-w-[950px]">
          <thead>
            <tr class="border-b border-primary/20 bg-primary/5 dark:bg-neutral-800/80 text-neutral-700 dark:text-neutral-200 font-bold">
              <th class="py-3.5 px-3">排位 / 品牌名称</th>
              <th class="py-3.5 px-3">综合评分</th>
              <th class="py-3.5 px-3">骨干线路拓扑</th>
              <th class="py-3.5 px-3">支持协议</th>
              <th class="py-3.5 px-3">节点数 / 覆盖</th>
              <th class="py-3.5 px-3">晚高峰测速 / 延迟</th>
              <th class="py-3.5 px-3">起步门槛 / 流量</th>
              <th class="py-3.5 px-3">原生住宅双 ISP</th>
              <th class="py-3.5 px-3">专属优惠码</th>
              <th class="py-3.5 px-3 text-center">状态</th>
              <th class="py-3.5 px-3 text-right">操作</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-200 dark:divide-neutral-700/60 text-neutral-600 dark:text-neutral-300">
            {sortedAirports.map((item, idx) => {
              const isResidential = item.id === "guangsucloud" || item.features.some(f => f.includes("住宅") || f.includes("双ISP"));
              const hasCustomClient = item.id === "guangsucloud" || item.features.some(f => f.includes("客户端") || f.includes("自研"));
              const isFast4K = item.speedMbps >= 800;

              return (
                <tr
                  class="airport-row hover:bg-primary/5 transition-colors"
                  data-name={item.name.toLowerCase()}
                  data-line={item.lineType}
                  data-price={item.monthlyPrice}
                  data-duration={item.minDuration}
                  data-protocols={item.protocols.join(" ").toLowerCase()}
                  data-residential={isResidential ? "true" : "false"}
                  data-custom-client={hasCustomClient ? "true" : "false"}
                  data-4k={isFast4K ? "true" : "false"}
                >
                  <!-- 排名与品牌 -->
                  <td class="py-3.5 px-3 font-bold text-neutral-800 dark:text-neutral-100">
                    <div class="flex items-center gap-2">
                      <span class={`w-5 h-5 rounded-full flex items-center justify-center text-[10px] font-bold shrink-0 ${
                        idx === 0 ? "bg-amber-500 text-white shadow-sm" :
                        idx === 1 ? "bg-slate-400 text-white" :
                        idx === 2 ? "bg-amber-700 text-white" :
                        "bg-neutral-200 dark:bg-neutral-700 text-neutral-600 dark:text-neutral-300"
                      }`}>
                        {idx + 1}
                      </span>
                      <a
                        href={`/reviews/${item.slug}`}
                        class="hover:text-primary transition-colors flex items-center gap-1 text-sm font-bold"
                      >
                        {item.name}
                      </a>
                      {idx === 0 && (
                        <span class="text-[10px] px-1.5 py-0.5 rounded bg-primary text-white font-bold">
                          金牌榜首
                        </span>
                      )}
                      {item.id === "xingdaomeng" && (
                        <span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-bold">
                          按量备用
                        </span>
                      )}
                    </div>
                    <div class="text-[11px] text-neutral-400 font-normal pl-7">
                      {item.established} 年运营
                    </div>
                  </td>

                  <!-- 综合评分 -->
                  <td class="py-3.5 px-3">
                    <div class="flex items-center gap-1">
                      <span class="font-bold text-sm text-neutral-900 dark:text-neutral-100">
                        {item.score.toFixed(1)}
                      </span>
                      <span class="text-[10px] text-neutral-400">/ 10</span>
                    </div>
                  </td>

                  <!-- 骨干线路 -->
                  <td class="py-3.5 px-3">
                    <span class={`inline-block px-2 py-0.5 rounded text-[11px] font-bold ${
                      item.lineType.includes("专线")
                        ? "bg-primary/10 text-primary"
                        : "bg-neutral-200 dark:bg-neutral-700 text-neutral-700 dark:text-neutral-300"
                    }`}>
                      {item.lineType}
                    </span>
                  </td>

                  <!-- 支持协议 -->
                  <td class="py-3.5 px-3 text-[11px]">
                    <div class="flex flex-wrap gap-1 max-w-[150px]">
                      {item.protocols.map(p => (
                        <span class="px-1.5 py-0.5 rounded bg-bg-primary dark:bg-neutral-800 border border-primary/10 text-neutral-600 dark:text-neutral-400 text-[10px]">
                          {p}
                        </span>
                      ))}
                    </div>
                  </td>

                  <!-- 节点数与覆盖 -->
                  <td class="py-3.5 px-3">
                    <div class="font-bold text-neutral-800 dark:text-neutral-200">
                      {item.nodeCount}+ 节点
                    </div>
                    <div class="text-[10px] text-neutral-400 truncate max-w-[120px]">
                      {item.regions.join(" / ")}
                    </div>
                  </td>

