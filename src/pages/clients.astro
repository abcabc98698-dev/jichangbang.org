  <section class="py-10 site-container" id="tun-mechanics">
    <div class="p-6 md:p-10 rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/20 shadow-sm">
      <div class="mb-6">
        <div class="mb-2 inline-block">
