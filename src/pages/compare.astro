  <!-- 轻量纯原生交互对比器执行脚本 -->
  <script is:inline define:vars={{ comparatorAirports }}>
    document.addEventListener("DOMContentLoaded", () => {
      const selectA = document.getElementById("select-airport-a");
      const selectB = document.getElementById("select-airport-b");
      const cardA = document.getElementById("card-airport-a");
      const cardB = document.getElementById("card-airport-b");

      if (!selectA || !selectB || !cardA || !cardB || !comparatorAirports) return;

      const airportsMap = {};
      comparatorAirports.forEach(a => {
        airportsMap[a.id] = a;
      });

      function updateCard(cardEl, airportData) {
        if (!airportData) return;
        const nameEl = cardEl.querySelector(".name-field");
        const scoreEl = cardEl.querySelector(".score-field");
        const priceEl = cardEl.querySelector(".price-field");
        const lineEl = cardEl.querySelector(".line-field");
        const speedEl = cardEl.querySelector(".speed-field");
        const aiEl = cardEl.querySelector(".ai-field");
        const couponEl = cardEl.querySelector(".coupon-field");
        const reviewLinkEl = cardEl.querySelector(".link-review");
        const officialLinkEl = cardEl.querySelector(".link-official");

        if (nameEl) nameEl.textContent = airportData.name;
        if (scoreEl) scoreEl.textContent = airportData.score;
        if (priceEl) priceEl.textContent = `¥${airportData.monthlyPrice} /月起 (${airportData.minDuration} · ${airportData.traffic}GB)`;
        if (lineEl) lineEl.textContent = `${airportData.lineType} · ${airportData.nodeCount}+ 节点`;
        if (speedEl) speedEl.textContent = `${airportData.speedMbps} Mbps 实测 · ${airportData.latencyMs}ms`;
        if (aiEl) aiEl.textContent = `${airportData.aiUnlock} · ${airportData.streamingUnlock}`;
        if (couponEl) couponEl.textContent = airportData.couponCode || '无优惠码';
        if (reviewLinkEl) {
          reviewLinkEl.setAttribute("href", `/reviews/${airportData.slug}`);
          reviewLinkEl.textContent = `查看${airportData.name.split(' ')[0]}深度评测 →`;
        }
        if (officialLinkEl) {
          officialLinkEl.setAttribute("href", airportData.affiliateUrl);
        }
      }

      selectA.addEventListener("change", (e) => {
        const selected = airportsMap[e.target.value];
        if (selected) updateCard(cardA, selected);
      });

      selectB.addEventListener("change", (e) => {
        const selected = airportsMap[e.target.value];
        if (selected) updateCard(cardB, selected);
      });
    });
  </script>
