---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/elements/PageHeader.astro";
import Badge from "@/components/ui/Badge.astro";
import JsonLd from "@/components/seo/JsonLd.astro";
import {
  Wrench,
  ShieldCheck,
  Award,
  Zap,
  Sparkles,
  Clock
} from "@lucide/astro";

const breadcrumbs = [
  { name: "首页", url: "/" },
  { name: "网络排障", url: "/issues" }
];

// 8组高价值网络排障深度长尾FAQ
const faqItems = [
  {
    question: "为什么关闭客户端后电脑无法上网，必须重新打开 Clash 才能打开网页？",
    answer: "这是因为客户端在退出时未能成功清除操作系统的全局代理设置。在开启系统代理模式时，客户端会将操作系统的网络设置指向本地回环端口（例如 127.0.0.1:7890）。若软件异常退出或强制结束进程，该端口设置依然残留在系统网络配置中，导致系统所有外发请求在寻找不存在的本地代理而形成死锁。解决方式非常简单，在 Windows 设置的‘网络和 Internet’中找到‘代理’选项，将‘使用代理服务器’开关手动关闭即可瞬间恢复正常上网。"
  },
  {
    question: "本地系统时间与网络时间相差几十秒，为什么会导致所有节点握手超时？",
    answer: "现代加密代理协议（例如 VMess、VLESS Reality 与 TLS 握手）深度依赖时间戳进行安全防重放攻击校验。客户端在与海外服务端发起认证通信时，服务端会对比客户端请求包中的时间戳。若本地系统时间与国际标准时间的偏差超过 60 到 90 秒，服务端安全机制会直接将其判定为恶意重放探测包并静默丢弃，表现为客户端测速全红超时。只需在操作系统时间设置中点击‘立即同步’互联网时间即可秒级解决。"
  },
  {
    question: "为什么手机端连接机场完全正常，但电脑端却全部显示红色超时？",
    answer: "同一套订阅在手机可用而在电脑不可用，说明机场服务端线路完全正常，故障出在电脑本地环境。通常由三类原因引起：第一，电脑本地杀毒软件或 Windows Defender 防火墙拦截了代理内核进程的网络出站权限；第二，电脑上同时运行了其他 VPN 软件或网页代理扩展插件，抢占了本地代理监听端口；第三，电脑本地时间未同步。建议关闭第三方杀毒软件并将 Clash 内核加入防火墙白名单，同时开启 TUN 模式排查本地端口冲突。"
  },
  {
    question: "订阅链接导入客户端时提示 Subscription Failed 或 404 应该怎么解决？",
    answer: "出现该提示代表客户端无法成功从服务商服务器拉取节点配置文件。首先应确认当前是否正处于断网状态，部分机场的订阅托管域名已被大陆公网直连屏蔽，此时需先借助已有临时可用节点或手机热点再点击更新。其次应登录机场用户官网后台，检查账户套餐是否已到期或流量耗尽，并尝试重新重置并复制最新的订阅链接。若依旧报错，可尝试在官网复制无需翻墙的备用订阅 URL 进行导入。"
  },
  {
    question: "开启代理后为什么国内微信、百度打不开，国外网页也打不开？",
    answer: "该现象属于典型的客户端路由配置冲突或 DNS 污染死循环。首先检查客户端当前运行模式是否被误设为了‘直连模式 (Direct)’或错误的全局代理模式。其次，在部分老旧的 Clash 配置文件中，若 DNS 模块被错误配置为仅使用海外不可达的 DNS 服务器，会导致本地所有域名的 IP 解析全部超时挂起。建议在客户端中切换至‘规则模式 (Rule)’，并在设置中开启系统默认内置的 Fake-IP 或 Redir-Host 模式，或切换至最新版本的 Clash Verge Rev 客户端。"
  },
  {
    question: "访问 OpenAI 或 Claude 时提示 Access Denied 或 1020 报错该如何快速恢复？",
    answer: "该报错代表当前节点的出口 IP 被 Cloudflare 边缘防火墙或 OpenAI 安全中心列入了高风险拦截名单。请按照四步进行自查修复：第一，确认当前出口未选择香港节点（OpenAI 与 Claude 官方从未支持香港地区）；第二，切换至日本、美国或新加坡等具备原生住宅双 ISP IP 的高纯净度专线节点；第三，在浏览器中开启无痕隐身窗口以隔离旧有的错误 Cookie 缓存；第四，在客户端设置中开启 TUN 虚拟网卡模式以防真实 DNS 发生泄漏。"
  },
  {
    question: "客户端频繁提示端口 7890 被占用或无法启动核心该怎么处理？",
    answer: "该故障说明系统中已有其他后台进程占用了 7890 监听端口。最常见的情况是之前运行的 Clash 内核未完全终止，仍在后台默默驻留。用户可打开任务管理器，在后台进程中查找名为 clash-meta、mihomo 或 xray 的进程并全部右键结束任务。或者直接在客户端软件的常规设置中，将‘混合代理端口’从默认的 7890 修改为 7892 或其他未被占用的端口号，随后重新启动内核即可顺利解决。"
  },
  {
    question: "为什么我们强烈建议常备一条不限时按量付费的备用专线？",
    answer: "在实际网络运维中，单一机场可能因骨干网故障、机房割接或域名受到短时攻击而暂时出现订阅无法刷新或节点抖动。如果手头仅有单一服务商，一旦遭遇突发故障便会陷入‘因无法翻墙而无法打开官网更新订阅’的死循环。常备一条像星岛梦那样永不过期的按量付费套餐，随用随扣不产生固定月租，在突发故障时能够充当最可靠的排障对照组与应急破局通道。"
  }
];

// 一分钟极速自检五步法
const quickSteps = [
  {
    step: "01",
    title: "校准系统互联网时间",
    desc: "误差超 60 秒会导致 TLS 握手直接被拒。在系统设置中点击‘立即同步时间’。",
    iconColor: "text-amber-500"
  },
  {
    step: "02",
    title: "核实账户配额与账单",
    desc: "登录机场后台，排查套餐是否到期，或当月流量耗尽触发系统自动熔断。",
    iconColor: "text-blue-500"
  },
  {
    step: "03",
    title: "检查代理开关与死锁",
    desc: "检查系统网络设置中‘使用代理服务器’开关，清除异常退出造成的 127.0.0.1 残留。",
    iconColor: "text-purple-500"
  },
  {
    step: "04",
    title: "切换单一节点与地区",
    desc: "避免单点机房临时割接维护误判为全网瘫痪，尝试切换至日本或新加坡节点测试。",
    iconColor: "text-emerald-500"
  },
  {
    step: "05",
    title: "启动异构备用专线交叉验证",
    desc: "启用第二备用梯子（如星岛梦按量节点），快速判定是本地宽带阻断还是单一服务商故障。",
    iconColor: "text-primary"
  }
