---
import Layout from "@/layouts/Layout.astro";
import HeroSection from "@/components/home/HeroSection.astro";
import SectionHeader from "@/components/elements/SectionHeader.astro";
import Button from "@/components/ui/Button.astro";
import Badge from "@/components/ui/Badge.astro";
import FAQ from "@/components/sections/FAQ.astro";
import BlogSection from "@/components/sections/BlogSection.astro";
import JsonLd from "@/components/seo/JsonLd.astro";
import { airports, getTopAirports, getBudgetAirports } from "@/data/airports";
import {
  ShieldCheck, Zap, Sparkles, CheckCircle2, ArrowRight,
  DollarSign, BarChart3, Scale, Layers, Laptop, Smartphone,
  Tv, Cpu, AlertTriangle, HelpCircle, ExternalLink, Flame
} from "@lucide/astro";

// 首页核心数据
const topAirports = getTopAirports(4);
const budgetAirports = getBudgetAirports();

// 首页 FAQ 问答
const faqItems = [
  {
    question: "2026年机场推荐应该怎么选？看哪些关键指标？",
    answer: "选择机场切忌只看宣传速度，核心应看 4 点：1. 底层线路（优先选择 IEPL/IPLC 内网专线，高峰期不过 GFW 审查不丢包）；2. 协议与客户端支持（主流推荐 Shadowsocks、Trojan，弱网移动端优选 Hysteria 2）；3. 解锁能力（是否具备纯净住宅/原生 IP 解锁 ChatGPT、Claude 及 Netflix）；4. 付款周期（建议新手优先‘月付’体验，切勿盲目充值多年付，降低跑路风险）。"
  },
  {
    question: "IEPL、IPLC 专线与普通公网中转机场有什么区别？",
    answer: "公网中转是通过国内服务器转发至境外公网，虽然比直连好，但国际出口高峰期依然受网络波动和防火墙审查干扰；而 IEPL/IPLC 是企业级内网物理专线，数据在两端机房直接通过专用光纤点对点传输，不经过公共互联网，因此在晚高峰 20:00-23:00 期间几乎零丢包、延迟极度平稳。"
  },
  {
    question: "为什么很多机场支持 ChatGPT 却无法访问 Claude？",
    answer: "OpenAI 与 Anthropic（Claude）的风控机制不同。Claude 3.5/3.7 对数据中心机房 IP（如 AWS、Linode、Cloudflare WARP）审查极其严格，一旦检测到多人共用或机房段即提示‘App not available in your region’。只有部署了原生家庭宽带（ISP/Residential IP）或经过独立清洁 IP 分流池的高端机场，才能稳定长效免验证登录 Claude。"
  },
  {
    question: "怎么防范机场跑路？有哪些危险信号？",
    answer: "机场跑路前通常会出现以下征兆：1. 突然推出夸张力度的‘永久会员’或‘2折年付/三年付’；2. 节点大面积超时超过 72 小时无人维护修复；3. Telegram 官方群开启全员禁言或频道被清空；4. 频繁更换不知名支付渠道。建议常备一主一备两家机场，且尽量选择运营 3 年以上的老牌服务商并按月订阅。"
  },
  {
    question: "按量付费（不限时流量）和月付套餐哪个划算？",
    answer: "如果你每天需要高强度跨境办公、刷高清视频或下载大文件，月付套餐（如 15-28 元/月包含 150G-300G）单价更划算；如果你只是偶尔查阅海外学术文献、使用 ChatGPT 辅助编程，或者需要一个防失联备用梯子，购买‘不限时按量付费’（如 10 元/100G 永不过期）性价比最高。"
  },
  {
    question: "新手使用什么客户端最稳定好上手？",
    answer: "Windows 推荐使用现代化的 Clash Verge Rev 或 v2rayN；macOS 推荐 Clash Verge Rev 或 Surge；iOS 推荐苹果美区商店下载 Shadowrocket（小火箭）或 Stash；Android 推荐 Clash Meta (Flclash) 或 v2rayNG。本站‘客户端’栏目提供全平台详细下载和一键导入教程。"
  }
];

// 结构化数据
const breadcrumbs = [
  { name: "首页", url: "/" }
];
---

<Layout
  title="机场榜一 — 2026性价比机场推荐榜 · VPN免费翻墙机场测评与稳定好用机场推荐更新"
  description="机场榜一 (jichangbang.org) 是全网权威客观的 2026 性价比机场推荐榜与实时评测总入口。提供 VPN 免费翻墙与专线机场测评、晚高峰测速、ChatGPT/Claude 场景解锁及稳定好用机场推荐更新。"
  keywords="2026性价比机场推荐榜, VPN, 免费翻墙, 机场测评, 稳定好用机场推荐更新, 机场推荐, 2026机场推荐, 机场排行榜, 机场哪个好, 高性价比机场, 便宜机场, 专线机场, IPLC机场, IEPL机场, ChatGPT机场, 机场榜一"
>
  <!-- SEO JSON-LD -->
  <JsonLd type="WebSite" />
  <JsonLd type="FAQPage" faqItems={faqItems} />
  <JsonLd type="BreadcrumbList" breadcrumbs={breadcrumbs} />

  <!-- 1. Hero 模块 -->
  <HeroSection />

  <!-- 2. 2026 机场推荐主榜 -->
  <section class="py-12 md:py-20 site-container" id="recommend">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8">
      <div>
        <div class="flex items-center gap-2 mb-2">
          <Badge variant="primary">核心转化推荐</Badge>
          <span class="text-xs text-neutral-400">实测更新：2026年9月</span>
        </div>
        <h2 class="text-2xl md:text-3xl font-bold font-brand text-neutral-900 dark:text-neutral-100">
          2026 机场推荐金牌主榜
        </h2>
        <p class="text-sm text-neutral-500 dark:text-neutral-400 mt-1 max-w-xl">
          基于全天候 20:00-23:00 晚高峰多地宽带测速、丢包率、流媒体解锁及抗封锁能力综合评选。
        </p>
      </div>
      <div class="mt-4 md:mt-0">
        <Button url="/recommend" className="text-sm">
          查看全部推荐清单 <ArrowRight size={14} />
        </Button>
      </div>
    </div>

    <!-- 推荐主榜卡片列表 -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {topAirports.map((airport, index) => (
        <div
          class="relative p-6 rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/15 dark:border-neutral-700 hover:shadow-lg transition-all duration-300 flex flex-col justify-between group"
          data-aos="fade-up-sm"
          data-aos-delay={index * 100}
          data-aos-once="true"
        >
          {airport.badge && (
            <span class="absolute -top-3 right-6 px-3 py-1 text-xs font-semibold rounded-full bg-primary text-white shadow-sm">
              {airport.badge}
            </span>
          )}

          <div>
            <div class="flex items-start justify-between gap-4 mb-3">
              <div>
                <div class="flex items-center gap-2">
                  <h3 class="text-xl font-bold text-neutral-800 dark:text-neutral-100 group-hover:text-primary transition-colors">
                    <a href={`/reviews/${airport.slug}`}>{airport.name}</a>
                  </h3>
                  <span class="text-xs px-2 py-0.5 rounded bg-primary/10 text-primary font-medium">
                    {airport.lineType}
                  </span>
                </div>
                <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1 leading-relaxed">
                  {airport.slogan}
                </p>
              </div>

              <div class="text-right flex-shrink-0">
                <span class="text-2xl font-black text-primary font-brand">{airport.score}</span>
                <span class="text-xs text-neutral-400 block">/ 10 分</span>
              </div>
            </div>

            <!-- 参数速览网格 -->
            <div class="grid grid-cols-4 gap-2 py-3 px-3.5 my-4 rounded-xl bg-bg-primary dark:bg-neutral-900/60 border border-primary/5 text-center">
              <div>
                <span class="block text-[11px] text-neutral-400">起步价格</span>
                <span class="text-sm font-bold text-neutral-800 dark:text-neutral-100 font-brand">¥{airport.monthlyPrice} <span class="text-[10px] font-normal text-neutral-400">/月</span></span>
              </div>
              <div>
                <span class="block text-[11px] text-neutral-400">月度流量</span>
                <span class="text-sm font-bold text-neutral-800 dark:text-neutral-100">{airport.traffic} GB</span>
              </div>
              <div>
                <span class="block text-[11px] text-neutral-400">晚高峰测速</span>
                <span class="text-sm font-bold text-emerald-600 dark:text-emerald-400">{airport.speedMbps} M</span>
              </div>
              <div>
                <span class="block text-[11px] text-neutral-400">平均延迟</span>
                <span class="text-sm font-bold text-neutral-800 dark:text-neutral-100">{airport.latencyMs} ms</span>
              </div>
            </div>

            <!-- 核心亮点与解锁 -->
            <div class="space-y-2 mb-4">
              <div class="flex items-center gap-2 text-xs text-neutral-600 dark:text-neutral-300">
                <CheckCircle2 class="w-4 h-4 text-emerald-500 flex-shrink-0" />
                <span><strong>优势：</strong>{airport.pros[0]}</span>
              </div>
              <div class="flex flex-wrap items-center gap-1.5 pt-1">
                <span class="text-[11px] text-neutral-400">场景支持：</span>
                {airport.aiUnlock.chatgpt && <span class="text-[10px] px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">ChatGPT 4o</span>}
                {airport.aiUnlock.claude && <span class="text-[10px] px-2 py-0.5 rounded bg-blue-500/10 text-blue-600 dark:text-blue-400">Claude 3.7</span>}
                {airport.streamingUnlock.netflix && <span class="text-[10px] px-2 py-0.5 rounded bg-purple-500/10 text-purple-600 dark:text-purple-400">Netflix 4K</span>}
                {airport.streamingUnlock.tiktok && <span class="text-[10px] px-2 py-0.5 rounded bg-amber-500/10 text-amber-600 dark:text-amber-400">TikTok 原生</span>}
              </div>
            </div>
          </div>

          <!-- 操作按钮与优惠 -->
          <div class="pt-4 border-t border-dashed border-neutral-200 dark:border-neutral-700/60 flex items-center justify-between gap-3">
            <div class="text-xs text-neutral-400">
              {airport.couponCode ? (
                <span>优惠码：<code class="px-1.5 py-0.5 rounded bg-primary/10 text-primary font-mono font-bold">{airport.couponCode}</code></span>
              ) : (
                <span>状态：<span class="text-emerald-500 font-medium">● 稳定运营中</span></span>
              )}
            </div>
            <div class="flex items-center gap-2">
              <a
                href={`/reviews/${airport.slug}`}
                class="px-3 py-1.5 text-xs font-medium rounded-lg text-neutral-600 dark:text-neutral-300 hover:text-primary hover:bg-primary/5 transition-colors"
              >
                评测详情
              </a>
              <Button
                url={`/reviews/${airport.slug}`}
                type="fill"
                className="text-xs px-3.5 py-1.5"
              >
                进入官网选购
              </Button>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 3. 本月高性价比机场与预算筛选 -->
  <section class="py-12 md:py-16 site-container" id="budget">
    <div class="p-8 rounded-2xl bg-gradient-to-br from-bg-secondary via-bg-secondary to-primary/5 dark:from-bg-secondary-dark dark:to-neutral-900 border border-primary/15 dark:border-neutral-700">
      <div class="max-w-2xl mb-6">
        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-500/10 text-amber-600 dark:text-amber-400 mb-2">
          <Flame class="w-3.5 h-3.5" /> 本月高性价比推荐专区
        </div>
        <h3 class="text-xl md:text-2xl font-bold font-brand text-neutral-900 dark:text-neutral-100">
          省钱不踩坑：10元 - 15元低门槛与不限时按量套餐
        </h3>
        <p class="text-sm text-neutral-500 dark:text-neutral-400 mt-1">
          专为学生、科研查阅及轻度出海用户挑选，拒绝年付绑架，支持灵活按月/按量购买。
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {budgetAirports.map((airport) => (
          <div class="p-4 rounded-xl bg-bg-primary dark:bg-neutral-800/80 border border-primary/10 dark:border-neutral-700 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="font-bold text-neutral-800 dark:text-neutral-100">{airport.name}</span>
                <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400 font-brand">¥{airport.monthlyPrice} / {airport.minDuration}</span>
              </div>
              <p class="text-xs text-neutral-500 dark:text-neutral-400 mb-3 line-clamp-2">
                {airport.slogan}
              </p>
              <div class="flex items-center gap-2 text-[11px] text-neutral-400 mb-2">
                <span>流量：{airport.traffic} GB</span>
                <span>•</span>
                <span>线路：{airport.lineType}</span>
              </div>
            </div>
            <a
              href={`/reviews/${airport.slug}`}
              class="inline-flex items-center justify-center gap-1 text-xs font-medium text-primary hover:underline pt-2 border-t border-dashed border-neutral-200 dark:border-neutral-700"
            >
              查看性价比评测 <ArrowRight size={12} />
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 全网知名机场品牌评测与收录大厅快捷通道 (167+ 家收录) -->
  <section class="py-4 site-container">
    <div class="p-5 md:p-6 rounded-2xl bg-gradient-to-r from-primary/10 via-bg-secondary to-bg-secondary dark:from-primary/20 dark:via-bg-secondary-dark dark:to-bg-secondary-dark border border-primary/20 flex flex-col md:flex-row items-center justify-between gap-4 shadow-sm">
      <div class="flex items-center gap-3.5">
        <div class="w-10 h-10 rounded-xl bg-primary/20 text-primary flex items-center justify-center shrink-0">
          <Sparkles class="w-5 h-5 text-primary" />
        </div>
        <div>
          <div class="flex items-center gap-2 mb-1">
            <h3 class="text-sm md:text-base font-bold text-neutral-900 dark:text-neutral-100">
              全网知名机场品牌评测与客观收录库 (已收录 167+ 家)
            </h3>
            <span class="text-[10px] px-2 py-0.5 rounded-full bg-primary/20 text-primary font-bold">NEW</span>
          </div>
          <p class="text-xs text-neutral-500 dark:text-neutral-400">
            涵盖 TAG、Nexitally、WgetCloud、魔戒、AmyTelecom、Fastlink 等 149 家全网主流品牌客观测速、真实资费及选购避坑指南。
          </p>
        </div>
      </div>
      <div class="flex items-center gap-2 shrink-0 w-full md:w-auto">
        <a
          href="/reviews"
          class="w-full md:w-auto text-center px-4 py-2 rounded-xl bg-primary text-white text-xs font-bold hover:brightness-110 shadow-md shadow-primary/20 transition-all whitespace-nowrap"
        >
          进入品牌评测大厅 &rarr;
        </a>
        <a
          href="/providers"
          class="w-full md:w-auto text-center px-3 py-2 rounded-xl bg-bg-primary dark:bg-neutral-800 text-neutral-700 dark:text-neutral-200 text-xs font-medium hover:bg-neutral-100 dark:hover:bg-neutral-700 border border-primary/15 transition-all whitespace-nowrap"
        >
          底层技术大盘
        </a>
      </div>
    </div>
  </section>

  <!-- 4. 价格快速筛选通道 -->
  <section class="py-8 site-container" id="pricing-filter">
    <div class="flex flex-wrap items-center justify-between gap-4 p-5 rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-dashed border-primary/20 dark:border-neutral-700">
      <div class="flex items-center gap-3">
        <DollarSign class="w-5 h-5 text-primary flex-shrink-0" />
        <span class="text-sm font-semibold text-neutral-800 dark:text-neutral-200">按月预算快速检索：</span>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <a href="/pricing#tier-10" class="px-3 py-1 rounded-lg text-xs bg-bg-primary dark:bg-neutral-800 hover:border-primary border border-transparent transition-all">10元机场</a>
        <a href="/pricing#tier-15" class="px-3 py-1 rounded-lg text-xs bg-bg-primary dark:bg-neutral-800 hover:border-primary border border-transparent transition-all">15元机场</a>
        <a href="/pricing#tier-20" class="px-3 py-1 rounded-lg text-xs bg-bg-primary dark:bg-neutral-800 hover:border-primary border border-transparent transition-all">20元专线</a>
        <a href="/pricing#tier-30" class="px-3 py-1 rounded-lg text-xs bg-bg-primary dark:bg-neutral-800 hover:border-primary border border-transparent transition-all">30-50元旗舰</a>
        <a href="/pricing#metered" class="px-3 py-1 rounded-lg text-xs bg-bg-primary dark:bg-neutral-800 hover:border-primary border border-transparent transition-all">不限时按量</a>
        <a href="/pricing#calculator" class="px-3 py-1 rounded-lg text-xs bg-primary text-white font-medium hover:opacity-90 transition-opacity">
          打开价格计算器 🧮
        </a>
      </div>
    </div>
  </section>

  <!-- 5. 机场综合排行榜全景 -->
  <section class="py-12 md:py-20 site-container" id="ranking">
    <SectionHeader
      title="2026 机场综合权威排行榜"
      description="涵盖综合指数、晚高峰实测速度、延迟响应、流媒体与 AI 解锁表现等多维打分系统。"
    />
    <div class="mt-8 overflow-x-auto">
      <table class="w-full text-left border-collapse rounded-xl overflow-hidden bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700">
        <thead>
          <tr class="bg-primary/5 dark:bg-neutral-800/70 border-b border-primary/10 dark:border-neutral-700 text-xs font-semibold text-neutral-600 dark:text-neutral-300">
            <th class="py-3.5 px-4 text-center w-16">名次</th>
            <th class="py-3.5 px-4">机场品牌</th>
            <th class="py-3.5 px-4">骨干线路</th>
            <th class="py-3.5 px-4">起步价格</th>
            <th class="py-3.5 px-4">月流量</th>
            <th class="py-3.5 px-4 text-center">晚高峰测速</th>
            <th class="py-3.5 px-4 text-center">AI/流媒体</th>
            <th class="py-3.5 px-4 text-center">综合评分</th>
            <th class="py-3.5 px-4 text-right">操作</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-primary/5 dark:divide-neutral-700/50 text-sm">
          {airports.map((item, idx) => (
            <tr class="hover:bg-primary/5 dark:hover:bg-neutral-800/40 transition-colors">
              <td class="py-4 px-4 text-center font-bold">
                {idx === 0 ? <span class="inline-flex w-6 h-6 rounded-full bg-amber-400 text-neutral-900 items-center justify-center text-xs">1</span> :
                 idx === 1 ? <span class="inline-flex w-6 h-6 rounded-full bg-slate-300 text-neutral-900 items-center justify-center text-xs">2</span> :
                 idx === 2 ? <span class="inline-flex w-6 h-6 rounded-full bg-amber-700 text-white items-center justify-center text-xs">3</span> :
                 <span class="text-neutral-400 text-xs">{idx + 1}</span>}
              </td>
              <td class="py-4 px-4">
                <a href={`/reviews/${item.slug}`} class="font-bold text-neutral-800 dark:text-neutral-100 hover:text-primary">
                  {item.name}
                </a>
                <span class="block text-xs text-neutral-400 mt-0.5">{item.features[0]}</span>
              </td>
              <td class="py-4 px-4">
                <span class="text-xs px-2 py-0.5 rounded bg-primary/10 text-primary font-medium">
                  {item.lineType}
                </span>
              </td>
              <td class="py-4 px-4 font-brand font-bold text-neutral-800 dark:text-neutral-100">
                ¥{item.monthlyPrice} <span class="text-xs font-normal text-neutral-400">/月</span>
              </td>
              <td class="py-4 px-4 text-neutral-600 dark:text-neutral-300">
                {item.traffic} GB
              </td>
              <td class="py-4 px-4 text-center font-semibold text-emerald-600 dark:text-emerald-400">
                {item.speedMbps} Mbps
              </td>
              <td class="py-4 px-4 text-center text-xs">
                <span class="text-emerald-500 font-medium">双解锁</span>
              </td>
              <td class="py-4 px-4 text-center">
                <span class="text-base font-bold font-brand text-primary">{item.score}</span>
              </td>
              <td class="py-4 px-4 text-right">
                <a
                  href={`/reviews/${item.slug}`}
                  class="inline-block px-3 py-1 rounded bg-primary text-white text-xs font-medium hover:opacity-90 transition-opacity"
                >
                  评测
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="mt-4 text-center">
      <a href="/ranking" class="inline-flex items-center gap-1.5 text-xs text-primary font-medium hover:underline">
