---
import Layout from "@/layouts/Layout.astro";
import Badge from "@/components/ui/Badge.astro";
import Button from "@/components/ui/Button.astro";
import JsonLd from "@/components/seo/JsonLd.astro";
import { airports, type Airport } from "@/data/airports";
import { directoryAirports } from "@/data/directory-airports";
import { getCollection, render } from "astro:content";
import {
  CheckCircle2, XCircle, ExternalLink, AlertTriangle, ShieldCheck, Zap, Image as ImageIcon, Sparkles
} from "@lucide/astro";

export async function getStaticPaths() {
  const allAirports = [...airports, ...directoryAirports];
  const allReviews = await getCollection("airportReviews");
  const reviewMap = new Map(allReviews.map(r => [r.id.replace(/\.(md|mdx)$/, ''), r]));

  return allAirports.map((airport) => ({
    params: { slug: airport.slug },
    props: {
      airport,
      reviewEntry: reviewMap.get(airport.slug) || null,
    },
  }));
}

interface Props {
  airport: Airport;
  reviewEntry?: any;
}

const { airport, reviewEntry } = Astro.props;

let RenderedContent: any = null;
let headings: Array<{ depth: number; slug: string; text: string }> = [];
if (reviewEntry) {
  const rendered = await render(reviewEntry);
  RenderedContent = rendered.Content;
  headings = rendered.headings.filter((h: any) => h.depth <= 2);
}

// 获取同类替代品牌（若为非推广客观收录品牌，固定向用户推荐排名前 3 的旗舰推广品牌）
const alternativeAirports = airport.isAffiliate === false
  ? airports.slice(0, 3)
  : airports.filter(a => a.id !== airport.id).slice(0, 3);

// 品牌 FAQ 数据
const brandFaqs = [
  {
    question: `${airport.name} 怎么样？好用稳定吗？`,
    answer: `${airport.name} 成立于 ${airport.established}，当前在机场榜一综合评分 ${airport.score} 分。其核心网络为 ${airport.lineType}，晚高峰实测速度达到 ${airport.speedMbps} Mbps，平均延迟 ${airport.latencyMs} ms。对于大部分用户而言，连通率与抗封锁表现处于上游水平。`
  },
  {
    question: `${airport.name} 支持 ChatGPT、Claude 和 Netflix 吗？`,
    answer: `${airport.name} 对流媒体及 AI 工具解锁支持状态：ChatGPT (${airport.aiUnlock.chatgpt ? '支持' : '不支持'})、Claude (${airport.aiUnlock.claude ? '支持' : '不支持'})、Netflix (${airport.streamingUnlock.netflix ? '支持' : '不支持'})、TikTok (${airport.streamingUnlock.tiktok ? '支持' : '不支持'})。`
  },
  {
    question: `${airport.name} 官网打不开或订阅失败怎么办？`,
    answer: `由于公共网络防火墙干扰，机场官网域名可能会阶段性更换。请关注本站提供的实时跳转通道。如遇订阅无法更新，请检查是否启用了系统代理，或在客户端中尝试临时开启全局代理后再进行订阅更新。`
  },
  {
    question: `${airport.name} 有跑路风险吗？当前运营状态如何？`,
    answer: `据机场榜一实时雷达监测，${airport.name} 当前状态为【${airport.riskStatus}】。监测备注：${airport.riskNote}。建议用户遵守‘优先月付、切勿盲目长期囤积年付’的基本原则。`
  }
];

const breadcrumbs = [
  { name: "首页", url: "/" },
  { name: "品牌评测", url: "/reviews" },
  { name: airport.name, url: `/reviews/${airport.slug}` }
];
---

<Layout
  title={`${airport.name} 怎么样？2026最新评测·套餐价格·线路测速与优惠码`}
  description={`${airport.name} 深度测评：${airport.slogan}。覆盖最低 ¥${airport.monthlyPrice} 套餐价格、${airport.lineType} 线路分析、晚高峰实测速度 ${airport.speedMbps}M、ChatGPT/Claude解锁能力及优缺点分析。`}
  keywords={`${airport.name}, ${airport.name}怎么样, ${airport.name}评测, ${airport.name}官网, ${airport.name}优惠码, ${airport.name}跑路了吗, 机场榜一`}
>
  <JsonLd type="BreadcrumbList" breadcrumbs={breadcrumbs} />
  <JsonLd type="FAQPage" faqItems={brandFaqs} />
  <JsonLd
    type="Review"
    data={{
      title: `${airport.name} 深度测评与晚高峰测速报告`,
      airportName: airport.name,
      description: airport.slogan || airport.description,
      monthlyPrice: airport.monthlyPrice,
      score: airport.score,
    }}
  />
  <JsonLd
    type="Article"
    article={{
      title: `${airport.name} 怎么样？2026最新评测·套餐价格·线路测速与优惠码`,
      description: `${airport.name} 深度测评：${airport.slogan}。覆盖最低 ¥${airport.monthlyPrice} 套餐价格、${airport.lineType} 线路分析、晚高峰实测速度 ${airport.speedMbps}M。`,
      publishDate: "2026-08-19",
      author: "机场榜网络技术评测组",
      url: `https://jichangbang.org/reviews/${airport.slug}`
    }}
  />

  <!-- 品牌顶部 Hero -->
  <section class="relative z-20 site-container my-8 md:my-14">
    <div class="p-6 md:p-10 rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/15">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
          <div class="flex flex-wrap items-center gap-2 mb-3">
            <Badge variant="primary">{airport.lineType}</Badge>
            {airport.badge && (
              <span class="text-xs px-2.5 py-0.5 rounded-full bg-primary/20 text-primary font-bold">
                ★ {airport.badge}
              </span>
            )}
            <span class="text-xs px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-medium">
              ● {airport.riskStatus}
            </span>
            <span class="text-xs text-neutral-400">已稳定运营：{airport.established}</span>
          </div>

          <h1 class="text-2xl md:text-4xl font-bold font-brand text-neutral-900 dark:text-neutral-100 mb-2">
            {airport.name} 深度评测与选购指南
          </h1>
          <p class="text-sm md:text-base text-neutral-600 dark:text-neutral-300 max-w-2xl leading-relaxed">
            {airport.slogan}
          </p>
          {airport.priceNote && (
            <div class="mt-3 inline-block text-xs px-3 py-1.5 rounded-lg bg-amber-500/10 text-amber-700 dark:text-amber-300 border border-amber-500/20">
              💡 <strong>价格提示：</strong> {airport.priceNote}
            </div>
          )}
        </div>

        <!-- 评分与官网直达卡片 -->
        <div class="p-5 rounded-xl bg-bg-primary dark:bg-neutral-800/80 border border-primary/15 text-center flex-shrink-0 min-w-[220px]">
          <span class="text-xs text-neutral-400 block mb-1">机场榜一综合评分</span>
          <div class="text-3xl font-black text-primary font-brand mb-1">
            {airport.score} <span class="text-xs font-normal text-neutral-400">/ 10</span>
          </div>
          <p class="text-[11px] text-neutral-400 mb-3">基于 {airport.ratingCount}+ 真实用户评测</p>
          {airport.isAffiliate === false ? (
            <div class="space-y-2">
              <a
                href={airport.officialUrl}
                target="_blank"
                rel="nofollow noopener noreferrer"
                class="inline-flex items-center justify-center gap-1.5 w-full py-2 px-3 rounded-xl bg-neutral-200 dark:bg-neutral-700 hover:bg-neutral-300 dark:hover:bg-neutral-600 text-neutral-800 dark:text-neutral-100 text-xs font-semibold transition-colors"
              >
                访问官网 (无专属折扣) <ExternalLink size={12} />
              </a>
              <a
                href="https://sahude.gsyvipaff.com/#/?code=keqgvT5Y"
                target="_blank"
                rel="nofollow sponsored noopener noreferrer"
                class="inline-flex items-center justify-center gap-1.5 w-full py-2 px-3 rounded-xl bg-primary text-white text-xs font-bold hover:brightness-110 shadow-md shadow-primary/20 transition-all animate-pulse"
              >
                ★ 前往金牌专线【光速云】<Sparkles size={12} />
              </a>
            </div>
          ) : (
            <Button url={airport.affiliateUrl} target="_blank" type="fill" className="text-xs w-full justify-center">
              进入官网选购 <ExternalLink size={12} />
            </Button>
          )}
          {airport.isAffiliate === false ? (
            <div class="mt-2.5 pt-2 border-t border-dashed border-primary/20 text-center">
              <span class="text-[11px] text-neutral-400 block">金牌榜首 8 折专享码：</span>
              <a href="/reviews/guangsu" class="text-xs px-2 py-0.5 rounded bg-primary/10 text-primary font-bold tracking-wider inline-block mt-1 hover:underline">
                AMM (光速云专用)
              </a>
            </div>
          ) : airport.couponCode && (
            <div class="mt-2.5 pt-2 border-t border-dashed border-primary/20 text-center">
              <span class="text-[11px] text-neutral-500 dark:text-neutral-400 block">专属折上折优惠码：</span>
              <code class="text-xs px-2 py-0.5 rounded bg-primary/10 text-primary font-bold tracking-wider inline-block mt-1">
                {airport.couponCode}
              </code>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  {/* 非 Affiliate 引流页面：首屏高转化拦截推荐横幅 */}
  {airport.isAffiliate === false && (
    <section class="site-container my-4">
      <div class="p-5 md:p-6 rounded-2xl bg-gradient-to-r from-amber-500/10 via-primary/10 to-emerald-500/10 border border-primary/30 flex flex-col md:flex-row items-center justify-between gap-5 shadow-sm">
        <div class="flex items-start md:items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-primary/15 text-primary flex items-center justify-center shrink-0 mt-0.5 md:mt-0">
            <Sparkles class="w-5 h-5 text-primary" />
          </div>
          <div>
            <div class="flex items-center gap-2 mb-1.5 flex-wrap">
              <span class="text-xs font-bold px-2 py-0.5 rounded bg-primary text-white">2026 金牌专线更优替代推荐</span>
              <span class="text-xs text-neutral-500 dark:text-neutral-400">更低延迟 · 0 丢包 · 原生住宅双 ISP</span>
            </div>
            <p class="text-xs md:text-sm text-neutral-700 dark:text-neutral-200 leading-relaxed">
              您当前正在查阅中立收录品牌 <strong>{airport.name}</strong> 的评测档案。若您正在寻找晚高峰更稳定、流媒体与 ChatGPT/Claude 100% 原生解锁的旗舰服务，强烈建议参考 2026 年度综合评分 9.9 分的 <strong>【光速云】</strong>（全节点 2.5Gbps IEPL 专线，月付 ¥19.9 起，使用本站专属 8 折优惠码：<code class="font-bold text-primary bg-primary/10 px-1 py-0.5 rounded">AMM</code>）。
            </p>
          </div>
        </div>
        <div class="flex items-center gap-2 shrink-0 w-full md:w-auto">
          <a
            href="https://sahude.gsyvipaff.com/#/?code=keqgvT5Y"
            target="_blank"
            rel="nofollow sponsored noopener noreferrer"
            class="w-full md:w-auto text-center px-4 py-2.5 rounded-xl bg-primary text-white text-xs font-bold hover:brightness-110 shadow-md shadow-primary/25 transition-all whitespace-nowrap"
          >
            直接抢购光速云 8 折 &rarr;
          </a>
          <a
            href="/reviews/guangsu"
            class="w-full md:w-auto text-center px-3 py-2.5 rounded-xl bg-bg-primary dark:bg-neutral-800 text-neutral-700 dark:text-neutral-200 text-xs font-medium hover:bg-neutral-100 dark:hover:bg-neutral-700 border border-primary/20 transition-all whitespace-nowrap"
          >
            深度实测报告
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- 核心规格参数速览表 -->
  <section class="py-6 site-container">
    <h2 class="text-xl font-bold font-brand text-neutral-900 dark:text-neutral-100 mb-4">
      📋 核心网络参数与规格矩阵
    </h2>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      <div class="p-4 rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10">
        <span class="text-xs text-neutral-400 block mb-1">入门套餐价格</span>
        <span class="text-lg font-bold font-brand text-neutral-800 dark:text-neutral-100">¥{airport.monthlyPrice} / {airport.minDuration}</span>
      </div>
      <div class="p-4 rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10">
        <span class="text-xs text-neutral-400 block mb-1">月度基准流量</span>
        <span class="text-lg font-bold text-neutral-800 dark:text-neutral-100">{airport.traffic} GB</span>
      </div>
      <div class="p-4 rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10">
        <span class="text-xs text-neutral-400 block mb-1">晚高峰平均测速</span>
        <span class="text-lg font-bold text-emerald-600 dark:text-emerald-400">{airport.speedMbps} Mbps</span>
      </div>
      <div class="p-4 rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10">
        <span class="text-xs text-neutral-400 block mb-1">端到端平均延迟</span>
        <span class="text-lg font-bold text-neutral-800 dark:text-neutral-100">{airport.latencyMs} ms</span>
      </div>
      <div class="p-4 rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10">
        <span class="text-xs text-neutral-400 block mb-1">骨干线路类型</span>
        <span class="text-sm font-bold text-primary">{airport.lineType}</span>
      </div>
      <div class="p-4 rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10">
        <span class="text-xs text-neutral-400 block mb-1">支持协议体系</span>
        <span class="text-xs font-medium text-neutral-700 dark:text-neutral-300">{airport.protocols.join(', ')}</span>
      </div>
      <div class="p-4 rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10">
        <span class="text-xs text-neutral-400 block mb-1">全球节点覆盖</span>
        <span class="text-sm font-bold text-neutral-800 dark:text-neutral-100">{airport.nodeCount}+ 个节点</span>
      </div>
      <div class="p-4 rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10">
        <span class="text-xs text-neutral-400 block mb-1">主要地区支持</span>
        <span class="text-xs font-medium text-neutral-700 dark:text-neutral-300">{airport.regions.join(' · ')}</span>
      </div>
    </div>
  </section>

  <!-- 品牌详情与长文剖析 -->
  <section class="py-8 site-container">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- 左侧主体内容 -->
      <div class="lg:col-span-2 space-y-8">
        {/* 1. 详细套餐规格（如果有 packages，始终保留展示，保障转化） */}
        {airport.packages && airport.packages.length > 0 && (
          <div class="p-6 rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10">
            <h2 class="text-xl font-bold font-brand text-neutral-900 dark:text-neutral-100 mb-4 flex items-center gap-2">
              <Sparkles class="w-5 h-5 text-primary" /> {airport.name} 热门主推套餐资费
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              {airport.packages.map((pkg, idx) => (
                <div class:list={[
                  "p-4 rounded-xl border flex flex-col justify-between transition-all",
                  idx === 1
                    ? "bg-primary/5 dark:bg-primary/10 border-primary shadow-sm"
                    : "bg-bg-primary dark:bg-neutral-800/80 border-primary/10"
                ]}>
                  <div>
                    <div class="flex items-center justify-between mb-2">
                      <h4 class="font-bold text-sm text-neutral-900 dark:text-neutral-100">{pkg.name}</h4>
                      {idx === 1 && <span class="text-[10px] px-2 py-0.5 rounded bg-primary text-white font-semibold">主推款</span>}
                    </div>
                    <div class="text-lg font-black text-primary font-brand mb-1">{pkg.price}</div>
                    <div class="text-xs text-neutral-500 mb-3">流量：<strong class="text-neutral-700 dark:text-neutral-300">{pkg.traffic}</strong> · 线路：{pkg.line}</div>
                    <ul class="text-[11px] space-y-1.5 text-neutral-600 dark:text-neutral-300 mb-4">
                      {pkg.features.map(feat => (
                        <li class="flex items-center gap-1.5">
                          <span class="text-emerald-500 font-bold">✓</span> {feat}
                        </li>
                      ))}
                    </ul>
                  </div>
                  <Button url={airport.affiliateUrl} target="_blank" type={idx === 1 ? "fill" : "outline"} className="text-xs w-full justify-center">
                    立即订阅
                  </Button>
                </div>
              ))}
            </div>
          </div>
        )}

        {/* 2. 晚高峰测速与解锁实测截图展厅（如果有截图，始终保留展示，保障真实证据） */}
        {airport.screenshots && airport.screenshots.length > 0 && (
          <div class="p-6 rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-xl font-bold font-brand text-neutral-900 dark:text-neutral-100 flex items-center gap-2">
                <ImageIcon class="w-5 h-5 text-primary" /> 晚高峰真实测速与流媒体解锁截图
              </h2>
              <span class="text-xs text-neutral-400">真实设备本地跑测</span>
            </div>
            <p class="text-xs text-neutral-500 dark:text-neutral-400 mb-4">
              以下截图为 2026 年最新实测采集，涵盖北方联通、南方电信以及移动多网晚高峰测速、千兆宽带跑满带宽及 Netflix/Disney+/ChatGPT 原生解锁矩阵：
            </p>
            <div class:list={[
              "gap-4",
              airport.screenshots?.length === 1
                ? "flex justify-center max-w-3xl mx-auto"
                : "grid grid-cols-1 sm:grid-cols-2"
            ]}>
              {airport.screenshots.map((imgSrc, i) => (
                <div class:list={[
                  "rounded-xl overflow-hidden border border-primary/15 bg-neutral-900 group",
                  airport.screenshots?.length === 1 ? "w-full shadow-md" : ""
                ]}>
                  <a href={imgSrc} target="_blank" rel="nofollow sponsored noopener">
                    <img
                      src={imgSrc}
                      alt={`${airport.name} 真实晚高峰测速与解锁实测图 ${i + 1}`}
                      class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-300"
                      loading="lazy"
                    />
                  </a>
                  <div class="p-2 text-center text-[11px] text-neutral-400 bg-neutral-800">
                    实测节点样本 #{i + 1}（点击可看大图）
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        {/* 3. 优缺点与人群画像（始终保留展示，直观定性） */}
        {airport.pros && airport.pros.length > 0 && (
          <div class="p-6 rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10">
            <h2 class="text-xl font-bold font-brand text-neutral-900 dark:text-neutral-100 mb-4">
              客观优缺点与适合人群画像
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <span class="text-xs font-bold text-emerald-500 flex items-center gap-1 mb-2">
                  <CheckCircle2 class="w-4 h-4" /> 核心优势 (Pros)
                </span>
                <ul class="text-xs space-y-2 text-neutral-600 dark:text-neutral-300">
                  {airport.pros.map(pro => (
                    <li class="flex items-start gap-1.5">
                      <span class="text-emerald-500 font-bold">•</span>
                      <span>{pro}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div>
                <span class="text-xs font-bold text-rose-500 flex items-center gap-1 mb-2">
                  <XCircle class="w-4 h-4" /> 不足与注意事项 (Cons)
                </span>
                <ul class="text-xs space-y-2 text-neutral-600 dark:text-neutral-300">
                  {airport.cons.map(con => (
                    <li class="flex items-start gap-1.5">
                      <span class="text-rose-500 font-bold">•</span>
                      <span>{con}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            {airport.targetUsers && airport.targetUsers.length > 0 && (
              <div class="mt-6 pt-4 border-t border-dashed border-neutral-200 dark:border-neutral-700 text-xs">
                <span class="font-bold text-neutral-800 dark:text-neutral-100 block mb-1">适合人群画像：</span>
                <p class="text-neutral-500">{airport.targetUsers.join('、')}</p>
              </div>
            )}
          </div>
        )}

        {/* 4. 深度评测长文专栏（存在万字评测时展示，无评测时走兜底） */}
        {RenderedContent ? (
          <div class="p-6 md:p-8 rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/15 shadow-sm space-y-6">
            <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-primary/10">
              <div class="flex items-center gap-2">
                <span class="text-xs px-2.5 py-1 rounded-full bg-primary text-white font-bold tracking-wider">
                  ★ 2026 万字深度测评专稿
                </span>
                <span class="text-xs text-neutral-500 dark:text-neutral-400 hidden sm:inline">
                  实测采集 · 拓扑拆解 · 避坑守则
                </span>
              </div>
              <span class="text-xs text-neutral-400">已核验更新</span>
            </div>

            {headings.length > 0 && (
