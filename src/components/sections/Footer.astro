---
import Logo from "@/components/ui/Logo.astro";
import ToTop from "@/components/widgets/ToTop.astro";
import { siteConfig, socialLinks } from "@/config/site.js";

const currentYear = new Date().getFullYear();

const footerLinks = {
  core: [
    { name: "2026 机场推荐", url: "/recommend" },
    { name: "机场综合排行", url: "/ranking" },
    { name: "热门品牌评测", url: "/reviews" },
    { name: "服务商数据库", url: "/providers" },
    { name: "价格套餐筛选", url: "/pricing" },
    { name: "两家机场对比", url: "/compare" },
  ],
  tech: [
    { name: "线路节点科普", url: "/protocols" },
    { name: "全平台客户端", url: "/clients" },
    { name: "新手与进阶教程", url: "/tutorials" },
    { name: "网络排障中心", url: "/issues" },
  ],
  scene: [
    { name: "AI与流媒体解锁", url: "/ai-streaming" },
    { name: "机场风险监控", url: "/risk" },
    { name: "高性价比预算榜", url: "/pricing" },
    { name: "常青知识百科", url: "/wiki" },
  ],
  about: [
    { name: "关于机场榜一", url: "/about" },
    { name: "评测与测速规范", url: "/tutorials" },
    { name: "风险与免责声明", url: "/risk" },
    { name: "网站地图与架构", url: "/providers" },
  ],
};

const templateVersion = "v2026.1";
---

<section class="text-gray-700 border-t mt-20 md:mt-32 border-dashed border-primary/15 dark:border-primary-dark/15 border-[.75px]">
  <div class="container mx-auto px-7 max-w-7xl py-12 md:py-16">
    <!-- Top: Logo + Description -->
    <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-8 mb-12">
      <div class="max-w-sm">
        <div class="flex items-center">
          <Logo />
        </div>
        <p class="mt-4 text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed">
          客观、专业、实测的 2026 机场推荐与综合排行榜单总入口。拒绝跑路暴雷，精选 IEPL/IPLC 专线，助力 ChatGPT、Claude 与 4K 全球流媒体流畅无阻。
        </p>
      </div>

      <!-- Four columns -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-8 md:gap-12">
        <!-- 核心推荐 -->
        <div>
          <h4 class="text-sm font-semibold text-neutral-800 dark:text-neutral-200 mb-4">核心推荐</h4>
          <ul class="space-y-3">
            {footerLinks.core.map((link) => (
              <li>
                <a href={link.url} class="text-sm text-neutral-500 dark:text-neutral-400 hover:text-primary dark:hover:text-primary-light transition-colors duration-200">
                  {link.name}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- 线路与工具 -->
        <div>
          <h4 class="text-sm font-semibold text-neutral-800 dark:text-neutral-200 mb-4">线路与工具</h4>
          <ul class="space-y-3">
            {footerLinks.tech.map((link) => (
              <li>
                <a href={link.url} class="text-sm text-neutral-500 dark:text-neutral-400 hover:text-primary dark:hover:text-primary-light transition-colors duration-200">
                  {link.name}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- 场景与风控 -->
        <div>
          <h4 class="text-sm font-semibold text-neutral-800 dark:text-neutral-200 mb-4">场景与安全</h4>
          <ul class="space-y-3">
            {footerLinks.scene.map((link) => (
              <li>
                <a href={link.url} class="text-sm text-neutral-500 dark:text-neutral-400 hover:text-primary dark:hover:text-primary-light transition-colors duration-200">
                  {link.name}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- 关于与声明 -->
        <div>
          <h4 class="text-sm font-semibold text-neutral-800 dark:text-neutral-200 mb-4">关于与指南</h4>
          <ul class="space-y-3">
            {footerLinks.about.map((link) => (
              <li>
                <a href={link.url} class="text-sm text-neutral-500 dark:text-neutral-400 hover:text-primary dark:hover:text-primary-light transition-colors duration-200">
                  {link.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-dashed border-primary/10 dark:border-primary-dark/10 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-sm text-neutral-400 dark:text-neutral-500">
        © {currentYear}
        <a href="/" class="hover:text-primary dark:hover:text-primary-light transition-colors">机场榜一 (jichangbang.org)</a>.
        保留所有权利。本站所有测速与评测数据均基于真实环境采样。
      </p>

      <div class="flex items-center gap-4">
        <span class="inline-flex items-center gap-2 text-xs text-neutral-400 dark:text-neutral-500">
          <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full border border-dashed border-primary/30 text-primary/80">
            <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
            {templateVersion}
          </span>
          <span>Built with Astro & Tailwind</span>
        </span>
        <span class="inline-flex justify-center space-x-4">
          {socialLinks.map((social) => (
            <a
              href={social.url}
              target="_blank"
              class="footer-social-icon-link text-neutral-400 dark:text-neutral-500 hover:text-primary dark:hover:text-primary-light transition-colors duration-200"
              title={social.name}
            >
              <span class="sr-only">{social.name}</span>
              <div class="footer-social-icon">
                <Fragment set:html={social.icon} />
              </div>
            </a>
          ))}
        </span>
      </div>
    </div>
  </div>
</section>

<!-- Back to top -->
<ToTop />

<style is:global>
  .footer-social-icon {
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .footer-social-icon svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  .footer-social-icon-link:hover .ic-twitter {
    color: #1DA1F2;
  }

  .footer-social-icon-link:hover .ic-github {
    color: #333;
  }

  .footer-social-icon-link:hover .ic-rss {
    color: #F26522;
  }
</style>
