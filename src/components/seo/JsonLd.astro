---
// JSON-LD 结构化数据生成组件 - SEO & GEO 友好
export interface Props {
  type?: 'WebSite' | 'Organization' | 'FAQPage' | 'ItemList' | 'BreadcrumbList' | 'Article' | 'HowTo' | 'WebPage' | 'CollectionPage';
  data?: any;
  faqItems?: Array<{ question: string; answer: string }>;
  breadcrumbs?: Array<{ name: string; url: string }>;
  itemList?: Array<{ name: string; url: string; position: number }>;
  article?: {
    title: string;
    description: string;
    publishDate?: Date | string;
    author?: string;
    url?: string;
    image?: string;
  };
  howToSteps?: Array<{ name: string; text: string; url?: string }>;
  webPage?: {
    name: string;
    description: string;
    url: string;
  };
}

const { type = 'WebSite', data, faqItems, breadcrumbs, itemList, article, howToSteps, webPage } = Astro.props;

let jsonLdPayload: any = null;

if (type === 'Organization') {
  jsonLdPayload = {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "机场榜一",
    "alternateName": "jichangbang.org",
    "url": "https://jichangbang.org",
    "logo": "https://jichangbang.org/favicon.png",
    "description": "专业客观的 2026 机场推荐、综合排行榜、品牌测评与价格对比平台。",
    "sameAs": [
      "https://x.com/jichangbang",
      "https://t.me/jichangbang",
      "https://github.com/jichangbang"
    ]
  };
} else if (type === 'WebSite') {
  jsonLdPayload = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "机场榜一",
    "alternateName": ["jichangbang.org", "机场榜", "2026机场推荐榜"],
    "url": "https://jichangbang.org",
    "potentialAction": {
      "@type": "SearchAction",
      "target": {
        "@type": "EntryPoint",
        "urlTemplate": "https://jichangbang.org/search?q={search_term_string}"
      },
      "query-input": "required name=search_term_string"
    },
    "description": "专业客观的 2026 机场推荐、综合排行榜、品牌测评与价格对比平台。"
  };
} else if (type === 'Article' && article) {
  jsonLdPayload = {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": article.title,
    "description": article.description,
    "datePublished": article.publishDate ? new Date(article.publishDate).toISOString() : new Date().toISOString(),
    "dateModified": article.publishDate ? new Date(article.publishDate).toISOString() : new Date().toISOString(),
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": article.url || "https://jichangbang.org/wiki"
    },
    "author": {
      "@type": "Organization",
      "name": article.author || "机场榜一团队",
      "url": "https://jichangbang.org"
    },
    "publisher": {
      "@type": "Organization",
      "name": "机场榜一",
      "logo": {
        "@type": "ImageObject",
        "url": "https://jichangbang.org/favicon.png"
      }
    },
    "image": article.image || "https://jichangbang.org/og.jpg"
  };
} else if (type === 'HowTo' && howToSteps && howToSteps.length > 0) {
  jsonLdPayload = {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": article?.title || "机场客户端配置与订阅导入操作指南",
    "description": article?.description || "手把手教你配置代理客户端、复制导入订阅并开启规则分流。",
    "step": howToSteps.map((step, idx) => ({
      "@type": "HowToStep",
      "position": idx + 1,
      "name": step.name,
      "text": step.text,
      "url": step.url || "https://jichangbang.org/tutorials"
    }))
  };
} else if (type === 'FAQPage' && faqItems && faqItems.length > 0) {
  jsonLdPayload = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqItems.map(item => ({
      "@type": "Question",
      "name": item.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": item.answer
      }
    }))
  };
} else if (type === 'BreadcrumbList' && breadcrumbs && breadcrumbs.length > 0) {
  jsonLdPayload = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": breadcrumbs.map((crumb, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "name": crumb.name,
      "item": crumb.url.startsWith('http') ? crumb.url : `https://jichangbang.org${crumb.url}`
    }))
  };
} else if (type === 'ItemList' && itemList && itemList.length > 0) {
  jsonLdPayload = {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "itemListElement": itemList.map(item => ({
      "@type": "ListItem",
      "position": item.position,
      "name": item.name,
      "url": item.url.startsWith('http') ? item.url : `https://jichangbang.org${item.url}`
    }))
  };
} else if (type === 'CollectionPage') {
  jsonLdPayload = {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": webPage?.name || article?.title || (data && data.name) || "机场榜一栏目索引",
    "description": webPage?.description || article?.description || (data && data.description) || "机场榜一精选专题栏目与内容集合",
    "url": webPage?.url || article?.url || (data && data.url) || "https://jichangbang.org"
  };
} else if (type === 'WebPage') {
  jsonLdPayload = {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": webPage?.name || article?.title || (data && data.name) || "机场榜一",
    "description": webPage?.description || article?.description || (data && data.description) || "专业客观的机场测评与推荐服务",
    "url": webPage?.url || article?.url || (data && data.url) || "https://jichangbang.org"
  };
} else if (data) {
  jsonLdPayload = data;
}
---

{jsonLdPayload && (
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdPayload)} />
)}
